{
  "schemaVersion": 1,
  "id": "local.souldesk.market",
  "name": "币安行情与价格警报",
  "version": "0.1.1",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": { "width": 760, "height": 720 },
  "minSize": { "width": 400, "height": 420 },
  "capabilities": ["storage.instance", "market.read", "alerts.manage"],
  "settingsSchema": {
    "type": "object",
    "properties": { "title": { "type": "string", "maxLength": 60, "default": "市场观察" } },
    "additionalProperties": false
  }
}
