{
  "name": "souldesk",
  "private": true,
  "version": "0.5.8",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/desktop.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "check": "tsc --noEmit && node scripts/desktop.mjs fmt -- --check",
    "test": "pnpm test:web && node scripts/desktop.mjs test --locked",
    "test:web": "node --test src/widget-url.test.ts src/widget-permissions.test.ts src/panel-layout.test.ts scripts/panel-groups-dom.test.mjs scripts/release.test.mjs scripts/verification-contract.test.mjs scripts/capabilities.test.mjs scripts/child-cleanup.test.mjs scripts/shorten-soak.test.mjs scripts/verify-upgrade.test.mjs sdk/host.test.js sdk/runtime.test.js",
    "build:web": "tsc --noEmit && vite build",
    "build": "node scripts/desktop.mjs build",
    "example:build": "node scripts/build-example.mjs",
    "g1:fixtures": "node scripts/build-g1-fixtures.mjs",
    "g1:verify": "node scripts/verify-installed.mjs --g1",
    "g2:verify": "node scripts/verify-installed.mjs --g2",
    "g3:verify": "node scripts/verify-installed.mjs --g3",
    "g3:upgrade": "node scripts/verify-upgrade.mjs",
    "market:probe": "node scripts/desktop.mjs market",
    "recovery:probe": "node scripts/desktop.mjs recovery",
    "network:probe": "node scripts/desktop.mjs network",
    "g0:verify": "node scripts/verify-installed.mjs",
    "g0:verify:auto": "node scripts/verify-installed.mjs --auto"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@antv/hierarchy": "0.7.1",
    "@antv/x6": "3.1.6",
    "@antv/x6-react-shape": "3.0.1",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "@excalidraw/excalidraw": "0.18.0",
    "@icon-park/vue-next": "1.4.2",
    "@tailwindcss/vite": "4.1.18",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vueuse/core": "15.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "color": "4.2.3",
    "colorthief": "2.6.0",
    "dayjs": "1.11.23",
    "dompurify": "3.4.18",
    "element-plus": "2.12.0",
    "emoji-mart": "5.6.0",
    "fflate": "0.8.3",
    "gsap": "3.14.2",
    "heic2any": "0.0.4",
    "jsdom": "28.1.0",
    "lucide-react": "0.563.0",
    "lunar-typescript": "1.8.7",
    "markmap-common": "0.18.9",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "mermaid": "11.12.2",
    "radix-ui": "1.4.3",
    "sass": "1.108.2",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vue": "3.5.45"
  }
}
