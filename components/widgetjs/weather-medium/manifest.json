{
  "schemaVersion": 1,
  "id": "local.souldesk.widgetjs.weather-medium",
  "name": "天气 · 中号",
  "version": "0.1.0",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": {
    "width": 420,
    "height": 260
  },
  "minSize": {
    "width": 240,
    "height": 210
  },
  "capabilities": [
    "storage.instance",
    "weather.read"
  ],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "cityId",
      "cityName",
      "unit",
      "fontSize",
      "radius",
      "foreground",
      "timezone"
    ],
    "properties": {
      "cityId": {
        "type": "string",
        "title": "城市标识",
        "maxLength": 32,
        "default": "101230206"
      },
      "cityName": {
        "type": "string",
        "title": "城市名称",
        "maxLength": 80,
        "default": "集美"
      },
      "unit": {
        "type": "string",
        "title": "温度单位",
        "maxLength": 1,
        "default": "C"
      },
      "fontSize": {
        "type": "integer",
        "title": "字号",
        "minimum": 10,
        "maximum": 30,
        "default": 14
      },
      "radius": {
        "type": "integer",
        "title": "圆角",
        "minimum": 0,
        "maximum": 40,
        "default": 22
      },
      "foreground": {
        "type": "string",
        "title": "文字颜色",
        "maxLength": 7,
        "default": "#26364a"
      },
      "timezone": {
        "type": "string",
        "title": "城市时区",
        "maxLength": 80,
        "default": "Asia/Shanghai"
      }
    }
  }
}
