{
  "schemaVersion": 1,
  "id": "local.souldesk.widgetjs.forex",
  "name": "汇率换算",
  "version": "0.1.2",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": { "width": 340, "height": 300 },
  "minSize": { "width": 260, "height": 240 },
  "capabilities": ["storage.instance", "content.source.forex", "images.https"],
  "settingsSchema": {
    "type": "object", "additionalProperties": false,
    "required": ["from", "to", "background", "foreground", "radius"],
    "properties": {
      "from": { "type": "string", "title": "来源币种", "maxLength": 3, "default": "USD" },
      "to": { "type": "string", "title": "目标币种", "maxLength": 3, "default": "CNY" },
      "background": { "type": "string", "title": "背景颜色", "maxLength": 7, "default": "#364052" },
      "foreground": { "type": "string", "title": "文字颜色", "maxLength": 7, "default": "#ffffff" },
      "radius": { "type": "integer", "title": "圆角", "minimum": 0, "maximum": 40, "default": 16 }
    }
  }
}
