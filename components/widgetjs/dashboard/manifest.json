{
  "schemaVersion":1,"id":"local.souldesk.widgetjs.dashboard","name":"仪表盘","version":"0.1.0","hostApiMajor":1,"loadCheck":1,
  "entry":"dist/dashboard/index.html","defaultSize":{"width":240,"height":240},"minSize":{"width":180,"height":180},
  "capabilities":["storage.instance","system.metrics"],
