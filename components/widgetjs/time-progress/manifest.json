{
  "schemaVersion": 1,
  "id": "local.souldesk.widgetjs.time-progress",
  "name": "时间进度",
  "version": "0.1.0",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": { "width": 400, "height": 240 },
  "minSize": { "width": 280, "height": 180 },
  "capabilities": ["storage.instance"],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "background", "foreground", "radius"],
    "properties": {
      "title": { "type": "string", "title": "标题", "maxLength": 40, "default": "时间进度" },
      "background": { "type": "string", "title": "背景颜色", "maxLength": 7, "default": "#faf7f2" },
      "foreground": { "type": "string", "title": "文字颜色", "maxLength": 7, "default": "#494644" },
      "radius": { "type": "integer", "title": "圆角", "minimum": 0, "maximum": 40, "default": 16 }
    }
  }
}
