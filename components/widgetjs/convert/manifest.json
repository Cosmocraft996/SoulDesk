{
  "schemaVersion":1,"id":"local.souldesk.widgetjs.convert","name":"图片格式转换","version":"0.1.0","hostApiMajor":1,"loadCheck":1,
  "entry":"dist/index.html","defaultSize":{"width":800,"height":600},"minSize":{"width":480,"height":360},
  "capabilities":["storage.instance","documents.user","assets.local"],
  "settingsSchema":{"type":"object","additionalProperties":false,"required":["format","width","height","keepAspectRatio"],"properties":{
    "format":{"type":"string","title":"输出格式（jpg/png/webp/bmp/ico）","maxLength":4,"default":"jpg"},
    "width":{"type":"integer","title":"输出宽度（0为原始）","minimum":0,"maximum":16384,"default":0},
    "height":{"type":"integer","title":"输出高度（0为原始）","minimum":0,"maximum":16384,"default":0},
    "keepAspectRatio":{"type":"boolean","title":"保持比例","default":true}
  }}
}
