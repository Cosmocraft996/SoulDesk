{
  "schemaVersion": 1,
  "id": "local.souldesk.widgetjs.wave-progress",
  "name": "波浪进度",
  "version": "0.1.0",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": { "width": 180, "height": 320 },
  "minSize": { "width": 140, "height": 220 },
  "capabilities": ["storage.instance"],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["period", "eventName", "startDate", "endDate", "accent", "radius"],
    "properties": {
      "period": { "type": "integer", "title": "进度类型", "minimum": 0, "maximum": 4, "default": 0 },
      "eventName": { "type": "string", "title": "事项名称", "maxLength": 40, "default": "今天" },
      "startDate": { "type": "string", "title": "开始时间", "maxLength": 40, "default": "" },
      "endDate": { "type": "string", "title": "结束时间", "maxLength": 40, "default": "" },
      "accent": { "type": "string", "title": "波浪颜色（留空使用时段配色）", "maxLength": 7, "default": "" },
      "radius": { "type": "integer", "title": "圆角", "minimum": 0, "maximum": 40, "default": 16 }
    }
  }
}
