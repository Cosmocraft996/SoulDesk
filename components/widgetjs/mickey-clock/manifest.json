{
  "schemaVersion": 1,
  "id": "local.souldesk.widgetjs.mickey-clock",
  "name": "米奇表盘",
  "version": "0.1.3",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": {
    "width": 320,
    "height": 320
  },
  "minSize": {
    "width": 180,
    "height": 180
  },
  "capabilities": [
    "storage.instance"
  ],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "background",
      "foreground",
      "radius",
      "fontSize"
    ],
    "properties": {
      "background": {
        "type": "string",
        "title": "背景颜色",
        "maxLength": 7,
        "default": "#202026"
      },
      "foreground": {
        "type": "string",
        "title": "文字颜色",
        "maxLength": 7,
        "default": "#f4f0e8"
      },
      "radius": {
        "type": "integer",
        "title": "圆角",
        "minimum": 0,
        "maximum": 40,
        "default": 16
      },
      "fontSize": {
        "type": "integer",
        "title": "字号",
        "minimum": 12,
        "maximum": 40,
        "default": 18
      }
    }
  }
}
