{
  "schemaVersion": 1,
  "id": "local.souldesk.widgetjs.grid",
  "name": "文件收纳盒",
  "version": "0.1.0",
  "hostApiMajor": 1,
  "loadCheck": 1,
  "entry": "dist/index.html",
  "defaultSize": {"width": 384, "height": 384},
  "minSize": {"width": 256, "height": 256},
  "capabilities": ["storage.instance", "files.launcher"],
  "settingsSchema": {
    "type": "object", "additionalProperties": false,
    "required": ["title", "gridCount", "sortBy", "sortMode", "includeFormats", "excludeFormats", "background", "color", "radius"],
    "properties": {
      "title": {"type": "string", "title": "标题", "maxLength": 120, "default": "📁文件夹"},
      "gridCount": {"type": "integer", "title": "网格数量", "minimum": 4, "maximum": 15, "default": 5},
      "sortBy": {"type": "string", "title": "排序字段", "maxLength": 12, "default": "name"},
      "sortMode": {"type": "string", "title": "排序方向", "maxLength": 4, "default": "asc"},
      "includeFormats": {"type": "string", "title": "包含格式", "maxLength": 1000, "default": ""},
      "excludeFormats": {"type": "string", "title": "排除格式", "maxLength": 1000, "default": ""},
      "background": {"type": "string", "title": "背景颜色", "maxLength": 7, "default": "#061d2e"},
      "color": {"type": "string", "title": "文字颜色", "maxLength": 7, "default": "#ffffff"},
      "radius": {"type": "integer", "title": "圆角", "minimum": 0, "maximum": 80, "default": 24}
    }
  }
}
