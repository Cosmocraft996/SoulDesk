{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "host",
  "description": "仅宿主容器允许基础事件；组件 iframe 不授予 Tauri 权限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "allow-snapshot",
    "allow-import-package",
    "allow-create-instance",
    "allow-manage-instance",
    "allow-reorder-instances",
    "allow-unregister-package",
    "allow-set-autostart",
    "allow-window-action",
    "allow-set-shortcut",
    "allow-schedule-test",
    "allow-report-view",
    "allow-business-settings",
    "allow-set-panel",
    "allow-update-preset"
    ,"allow-save-panel-layout", "allow-app-update"
  ]
}
