{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "detail",
  "description": "正式展示容器的最小能力；组件页面不授予原生命令",
  "windows": [
    "detail-*"
  ],
  "permissions": [
    "core:event:default",
    "allow-snapshot",
    "allow-open-session",
    "allow-close-session",
    "allow-widget-request",
    "allow-window-action",
    "allow-surface-failed"
  ]
}
