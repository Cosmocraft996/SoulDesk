+#if SOULDESK_GRID_PREVIEW
+using DeskBox.Services;
+using Microsoft.UI.Dispatching;
+using Microsoft.UI.Xaml;
+using System.Diagnostics;
+using System.Runtime.CompilerServices;
+
+namespace DeskBox;
+
+internal static class ReferenceGridEntry
+{
+    private static readonly Stopwatch Startup = Stopwatch.StartNew();
+
+    [STAThread]
+    private static void Main()
+    {
+        Record("managed-entry");
+        try
+        {
+            StartWinUI();
+        }
+        catch (Exception error)
+        {
+            File.WriteAllText(Path.Combine(ReferenceGridPreview.Root, "preview-error.txt"), error.ToString());
+            Environment.ExitCode = 1;
+        }
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    private static void StartWinUI()
+    {
+        Record("winrt-initialize");
+        WinRT.ComWrappersSupport.InitializeComWrappers();
+        Record("xaml-start");
+        Application.Start(parameters =>
+        {
+            Record("xaml-callback");
+            SynchronizationContext.SetSynchronizationContext(
+                new DispatcherQueueSynchronizationContext(DispatcherQueue.GetForCurrentThread()));
+            _ = new App();
+        });
+    }
+
+    internal static void Record(string stage) =>
+        File.AppendAllText(Path.Combine(ReferenceGridPreview.Root, "preview-startup.log"),
+            $"{Startup.ElapsedMilliseconds} {stage}{Environment.NewLine}");
+}
+#endif
diff --git a/src/DeskBox/Services/ReferenceGridPreview.cs b/src/DeskBox/Services/ReferenceGridPreview.cs
new file mode 100644
index 0000000..96f4a41
--- /dev/null
+++ b/src/DeskBox/Services/ReferenceGridPreview.cs
@@ -0,0 +1,387 @@
+#if SOULDESK_GRID_PREVIEW
+using System.Text.Json;
+using DeskBox.Controls;
+using DeskBox.Helpers;
+using DeskBox.Models;
+using Windows.Graphics;
+
+namespace DeskBox.Services;
+
+// 样例工作区是唯一允许写入配置和读取成员的目录。格子成员是路径引用。
+internal sealed class ReferenceGridPreview
+{
+    public const string GroupKey = "souldesk-reference-group";
+    internal const string BoxKey = "souldesk-reference-box";
+    internal const string StackKey = "souldesk-reference-stack";
+    internal const string OpacityKey = "souldesk-reference-opacity";
+    internal static readonly string[] StackKeys =
+    [
+        WidgetFileStackSettings.EnabledOverrideMetadataKey, WidgetFileStackSettings.GroupByOverrideMetadataKey,
+        WidgetFileStackSettings.ThresholdOverrideMetadataKey, WidgetFileStackSettings.OrderByOverrideMetadataKey,
+        WidgetFileStackSettings.OpenModeOverrideMetadataKey, WidgetFileStackSettings.DisabledStacksMetadataKey,
+        WidgetFileStackSettings.StackNameOverridesMetadataKey, WidgetFileStackSettings.StackOrderMetadataKey,
+        WidgetFileStackSettings.StackMemberOverridesMetadataKey
+    ];
+    internal static readonly string[] ArtworkKeys =
+    [
+        WidgetTitleIconCustomization.EmojiMetadataKey, WidgetTitleIconCustomization.ImageMetadataKey,
+        WidgetBackgroundCustomization.ImageMetadataKey, WidgetBackgroundCustomization.FitMetadataKey,
+        WidgetBackgroundCustomization.DimMetadataKey, WidgetBackgroundCustomization.ColorMetadataKey,
+        WidgetBorderCustomization.ModeMetadataKey, WidgetChromeModeNames.MetadataKey,
+        WidgetForegroundSettings.ModeOverrideMetadataKey, WidgetForegroundSettings.ColorOverrideMetadataKey
+    ];
+    internal string AssetDirectory => Path.Combine(Path.GetDirectoryName(Root)!, "artwork");
+    private const string Marker = "souldesk-deskbox-grid-preview-v1";
+    private static readonly Lazy<string> RequiredRoot = new(ValidateLaunch);
+    private static readonly StringComparer Paths = StringComparer.OrdinalIgnoreCase;
+    private readonly object _gate = new();
+    private Dictionary<string, string[]> _groups;
+
+    public static string Root => RequiredRoot.Value;
+    public static ReferenceGridPreview? Current { get; private set; }
+    public const string First = "reference-project";
+    public const string Second = "reference-archive";
+
+    private ReferenceGridPreview()
+    {
+        string workspace = IsRenderer && !UsesDesktop ? Path.GetDirectoryName(Root)! : Root;
+        FixtureRoot = Path.Combine(workspace, "fixtures");
+        if (IsRenderer)
+        {
+            Renderer = new ReferenceGridRenderer(Root, UsesDesktop, IsSettings);
+            _groups = [];
+            return;
+        }
+        _groups = File.Exists(StatePath)
+            ? JsonSerializer.Deserialize<Dictionary<string, string[]>>(File.ReadAllText(StatePath))
+                ?? throw new InvalidDataException("格子布局无法读取。")
+            : new Dictionary<string, string[]>
+            {
+                [First] = ["项目清单.txt", "会议记录.md", "任务进度.csv"],
+                [Second] = ["发布记录.txt"],
+            };
+    }
+
+    public static ReferenceGridPreview Initialize() => Current ??= new();
+
+    private static bool IsRenderer => Environment.GetCommandLineArgs()[1] is "--souldesk-grid-renderer" or "--souldesk-grid-desktop"
+        or "--souldesk-grid-settings";
+    private static bool IsSettings => Environment.GetCommandLineArgs()[1] == "--souldesk-grid-settings";
+    internal static bool UsesDesktop => Environment.GetCommandLineArgs()[1] == "--souldesk-grid-desktop";
+    public string FixtureRoot { get; }
+    internal ReferenceGridRenderer? Renderer { get; }
+    private string StatePath { get; } = Path.Combine(Root, "reference-groups.json");
+    internal event Action? MembershipChanged;
+
+    internal static bool GroupWheel(ReferenceGridRenderer.BoxData box) =>
+        box.GroupWheel ?? App.Current.SettingsService.Settings.WidgetGroupWheelSwitchEnabled;
+
+    internal static bool GroupHover(ReferenceGridRenderer.BoxData box) =>
+        box.GroupHoverOverride ?? (box.GroupHover || App.Current.SettingsService.Settings.WidgetGroupHoverSwitchEnabled);
+
+    internal WidgetGroupPresentation? GroupPresentation(WidgetConfig config)
+    {
+        if (!config.Metadata.TryGetValue(BoxKey, out var id) ||
+            Renderer?.State.Boxes.FirstOrDefault(item => item.Box.Id == id)?.Box is not
+                { Tabs.Length: > 1 } box)
+            return null;
+        var members = box.Tabs.Select(tab => new WidgetGroupMemberPresentation(tab.Id, tab.Name,
+            WidgetKind.File, "\uE8B7", WidgetTitleIconKindNames.FromWidgetKind(WidgetKind.File),
+            tab.Id == box.Active, tab.Artwork?.GetValueOrDefault(WidgetTitleIconCustomization.EmojiMetadataKey) ?? "",
+            WidgetTitleIconAssetStore.Current.ResolveImagePath(tab.Id,
+                tab.Artwork?.GetValueOrDefault(WidgetTitleIconCustomization.ImageMetadataKey)))).ToArray();
+        return new WidgetGroupPresentation(box.Id, box.Id, box.Active,
+            WidgetGroupNavigationStyles.Normalize(box.GroupNavigation ?? App.Current.SettingsService.Settings.WidgetGroupDefaultNavigationStyle, allowFollowDefault: false),
+            WidgetGroupTitleDisplayModes.Normalize(box.GroupTitleDisplay ?? App.Current.SettingsService.Settings.WidgetGroupDefaultTitleDisplayMode, allowFollowDefault: false),
+            GroupWheel(box), GroupHover(box), members);
+    }
+
+    internal Task<bool>? SubmitBoxAsync(WidgetConfig config, string action, string? tab = null,
+        bool? collapsed = null, string? target = null, string[]? expectedTabs = null, string? collapseMode = null) =>
+        config.Metadata.TryGetValue(BoxKey, out var id)
+            ? Renderer?.SubmitBoxAsync(action, id, tab, collapsed, target: target, expectedTabs: expectedTabs,
+                collapseMode: collapseMode) : null;
+
+    internal RectInt32? DesktopBounds(WidgetConfig config)
+    {
+        if (Renderer is not { State.DesktopLayer: not null } renderer ||
+            !config.Metadata.TryGetValue(BoxKey, out var id) ||
+            renderer.State.Boxes.FirstOrDefault(item => item.Box.Id == id) is not { } placement)
+            return null;
+        return new RectInt32(placement.X, placement.Y, placement.Width, placement.Height);
+    }
+
+    internal Task<bool>? SubmitSettingAsync(WidgetConfig config, string setting, string? value = null, string action = "edit") =>
+        Renderer is { } renderer &&
+        config.Metadata.TryGetValue(BoxKey, out var box) && config.Metadata.TryGetValue(GroupKey, out var tab)
+            ? renderer.SubmitSettingAsync(action, box, tab, setting, value)
+            : null;
+
+    internal void PersistMetadata(WidgetConfig config, string setting, string[] keys)
+    {
+        if (Renderer is not { } renderer || !config.Metadata.TryGetValue(BoxKey, out var box) ||
+            !config.Metadata.TryGetValue(GroupKey, out var tab))
+            return;
+        var metadata = keys.Where(config.Metadata.ContainsKey).ToDictionary(key => key, key => config.Metadata[key]);
+        _ = ObserveBoxEditAsync(renderer.SubmitSettingAsync("edit", box, tab, setting, null, metadata));
+    }
+
+    internal static bool ApplyMetadata(WidgetConfig config, string[] keys, Dictionary<string, string>? values,
+        string? preserveMissingKey = null)
+    {
+        bool changed = false;
+        foreach (var key in keys)
+        {
+            if (values is not null && values.TryGetValue(key, out var value))
+            {
+                changed |= !config.Metadata.TryGetValue(key, out var old) || old != value;
+                config.Metadata[key] = value;
+            }
+            else if (key != preserveMissingKey)
+                changed |= config.Metadata.Remove(key);
+        }
+        return changed;
+    }
+
+    internal bool CanReadMappedFolder(string folder) => UsesDesktop || IsFixtureLocation(folder);
+
+    internal static bool UsesAutomaticStacks(WidgetConfig config) =>
+        AutomaticStackOverride(config) ?? App.Current.SettingsService.Settings.FileStackAutoStacking;
+
+    internal static bool? AutomaticStackOverride(WidgetConfig config) =>
+        config.Metadata.TryGetValue(StackKey, out string? value) ? value == "true" : null;
+
+    internal static bool? StackOverride(ReferenceGridRenderer.Tab? tab) =>
+        tab?.AutoStack ?? (tab?.StackByType == true ? true : null);
+
+    internal static void SetStackPreference(WidgetConfig config, bool? value)
+    {
+        if (value is bool enabled) config.Metadata[StackKey] = enabled ? "true" : "false";
+        else config.Metadata.Remove(StackKey);
+    }
+
+    internal static void SetAppearance(WidgetConfig config, string? color, int? opacity)
+    {
+        WidgetBackgroundCustomization.SetColorOverride(config,
+            color is not (null or "#283635") && AccentColorHelper.TryParseHex(color, out var parsed) ? parsed : null);
+        if (opacity is int value)
+            config.Metadata[OpacityKey] = Math.Clamp(value, 35, 100).ToString(System.Globalization.CultureInfo.InvariantCulture);
+        else
+            config.Metadata.Remove(OpacityKey);
+    }
+
+    internal Task<bool>? SavePositionAsync(WidgetConfig config, RectInt32 bounds, bool resize, double? capsuleWidth)
+    {
+        if (!config.Metadata.TryGetValue(BoxKey, out string? id) || Renderer is not { State.Visible: true } renderer ||
+            renderer.State.Boxes.FirstOrDefault(item => item.Box.Id == id) is not { } placement)
+            return null;
+        return bounds.X == placement.X && bounds.Y == placement.Y &&
+               bounds.Width == placement.Width && bounds.Height == placement.Height &&
+               (capsuleWidth is null || capsuleWidth == placement.Box.CapsuleWidth)
+            ? null
+            : renderer.SubmitBoxAsync(resize ? "resize" : "position", id, bounds: bounds, capsuleWidth: capsuleWidth);
+    }
+
+    internal static async Task ObserveBoxEditAsync(Task<bool> operation)
+    {
+        try { await operation; }
+        catch (Exception error) { App.Log($"保存桌面格子设置失败 {error.Message}"); }
+    }
+
+    internal static T DisableMenu<T>(T item, string reason = "暂未接入 SoulDesk")
+        where T : Microsoft.UI.Xaml.Controls.MenuFlyoutItemBase
+    {
+        if (item is Microsoft.UI.Xaml.Controls.MenuFlyoutSubItem submenu && submenu.Items.Count > 0)
+        {
+            foreach (var child in submenu.Items) DisableMenu(child, reason);
+        }
+        else if (item is Microsoft.UI.Xaml.Controls.MenuFlyoutItem command)
+        {
+            command.IsEnabled = false;
+            command.Text += " · " + reason;
+            Microsoft.UI.Xaml.Automation.AutomationProperties.SetHelpText(command, reason);
+        }
+        return item;
+    }
+
+    public IReadOnlyList<string> GetFiles(string group)
+    {
+        if (Renderer is { } renderer)
+        {
+            var tab = renderer.State.Boxes.SelectMany(placement => placement.Box.Tabs)
+                .FirstOrDefault(item => item.Id == group);
+            if (tab?.Folder is { } folder && (UsesDesktop || IsFixtureLocation(folder)) && Directory.Exists(folder))
+                return Directory.GetFileSystemEntries(folder).Where(path => UsesDesktop || IsFixtureLocation(path)).ToArray();
+            return tab?.Items.Where(IsFixturePath).ToArray() ?? [];
+        }
+        lock (_gate)
+        {
+            return _groups.TryGetValue(group, out string[]? paths)
+                ? paths.Select(name => Path.GetFullPath(name, FixtureRoot))
+                    .Where(IsFixturePath).ToArray()
+                : [];
+        }
+    }
+
+    public bool IsFixturePath(string candidate) =>
+        (UsesDesktop || IsFixtureLocation(candidate)) &&
+        (Renderer is null || Path.IsPathFullyQualified(candidate) && Renderer.Contains(candidate));
+
+    private bool IsFixtureLocation(string candidate)
+    {
+        if (!Path.IsPathFullyQualified(candidate))
+            return false;
+
+        try
+        {
+            string full = Path.GetFullPath(candidate);
+            if (!full.StartsWith(FixtureRoot + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
+                return false;
+            string relative = Path.GetRelativePath(FixtureRoot, full);
+            string path = FixtureRoot;
+            foreach (string segment in relative.Split(Path.DirectorySeparatorChar))
+            {
+                if (segment.Contains(':'))
+                    return false;
+                path = Path.Combine(path, segment);
+                if ((File.GetAttributes(path) & FileAttributes.ReparsePoint) != 0)
+                    return false;
+            }
+            return true;
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException)
+        {
+            return false;
+        }
+    }
+
+    public IReadOnlyList<string> Attach(string group, IEnumerable<string> files, int? index = null)
+    {
+        var accepted = files.Where(IsFixturePath).Select(Path.GetFullPath).Distinct(Paths).ToArray();
+        if (accepted.Length == 0)
+            return [];
+
+        lock (_gate)
+        {
+            if (!_groups.TryGetValue(group, out string[]? target))
+                return [];
+
+            var relative = accepted.Select(path => Path.GetRelativePath(FixtureRoot, path)).ToHashSet(Paths);
+            int insert = index is null ? target.Length : Math.Clamp(index.Value, 0, target.Length);
+            int adjusted = target.Take(insert).Count(path => !relative.Contains(path));
+            var next = _groups.ToDictionary(entry => entry.Key,
+                entry => entry.Value.Where(path => !relative.Contains(path)).ToArray());
+            var members = next[group].ToList();
+            members.InsertRange(adjusted, accepted.Select(path => Path.GetRelativePath(FixtureRoot, path)));
+            next[group] = [.. members];
+            Save(next);
+        }
+
+        MembershipChanged?.Invoke();
+        return accepted;
+    }
+
+    internal Task<IReadOnlyList<string>> AttachAsync(string group, IEnumerable<string> files, int? index,
+        CancellationToken cancellationToken, string? before = null, string[]? displayOrder = null)
+    {
+        if (Renderer is null)
+            return Task.FromResult(Attach(group, files, index));
+        var paths = files.Where(IsFixturePath).Select(Path.GetFullPath).Distinct(Paths).ToArray();
+        if (paths.Length == 0)
+            return Task.FromResult<IReadOnlyList<string>>([]);
+        return Renderer.SubmitAsync("group", group, paths, before, cancellationToken, displayOrder);
+    }
+
+    internal async Task ReleaseAsync(string group, string path)
+    {
+        if (Renderer is null)
+            Release(group, path);
+        else if (IsFixturePath(path))
+            await Renderer.SubmitAsync("release", group, [path], null, CancellationToken.None);
+    }
+
+    public void Release(string group, string path)
+    {
+        if (!IsFixturePath(path))
+            return;
+        lock (_gate)
+        {
+            if (!_groups.TryGetValue(group, out string[]? target))
+                return;
+            string relative = Path.GetRelativePath(FixtureRoot, path);
+            var next = new Dictionary<string, string[]>(_groups);
+            next[group] = target.Where(item => !Paths.Equals(item, relative)).ToArray();
+            Save(next);
+        }
+        MembershipChanged?.Invoke();
+    }
+
+    private void Save(Dictionary<string, string[]> next)
+    {
+        string staged = StatePath + ".pending";
+        File.WriteAllText(staged, JsonSerializer.Serialize(next, new JsonSerializerOptions { WriteIndented = true }));
+        File.Move(staged, StatePath, overwrite: true);
+        _groups = next;
+    }
+
+    private static string ValidateLaunch()
+    {
+        string[] args = Environment.GetCommandLineArgs();
+        try
+        {
+            if (args.Length == 3 && Path.IsPathFullyQualified(args[2]))
+            {
+                string root = Path.TrimEndingDirectorySeparator(Path.GetFullPath(args[2]));
+                string name = Path.GetFileName(root);
+                string parent = Path.GetDirectoryName(root) ?? "";
+                bool normalPreview = args[1] == "--souldesk-grid-preview" &&
+                    name.StartsWith("deskbox-preview-", StringComparison.Ordinal) &&
+                    IsRegularFile(Path.Combine(root, "isolated-test-data.marker")) &&
+                    File.ReadAllText(Path.Combine(root, "isolated-test-data.marker")).Trim() == Marker;
+                bool engine = args[1] is "--souldesk-grid-renderer" or "--souldesk-grid-desktop" or "--souldesk-grid-settings" &&
+                    name.StartsWith("deskbox-renderer-", StringComparison.Ordinal) &&
+                    Guid.TryParseExact(name["deskbox-renderer-".Length..], "N", out _) &&
+                    IsRegularFile(Path.Combine(root, "state.json"));
+                bool enginePreview = engine && args[1] == "--souldesk-grid-renderer" &&
+                    Path.GetFileName(parent).StartsWith("desktop-integration-", StringComparison.Ordinal) &&
+                    IsRegularFile(Path.Combine(parent, "isolated-test-data.marker"));
+                bool desktop = engine && args[1] == "--souldesk-grid-desktop";
+                bool settings = engine && args[1] == "--souldesk-grid-settings";
+                if (!root.StartsWith(@"\\") && NoReparseDirectories(root) &&
+                    (normalPreview && NoReparseDirectories(Path.Combine(root, "fixtures")) ||
+                        enginePreview && NoReparseDirectories(Path.Combine(parent, "fixtures")) || desktop || settings))
+                {
+                    foreach (string ownedPath in new[] { "data", "reference-groups.json", "reference-groups.json.pending",
+                        "DeskBox.log", "preview-startup.log", "preview-ready.json", "preview-error.txt", "request.json",
+                        "pulse.json", "pulse.tmp", "settings-test.json" })
+                    {
+                        string entry = Path.Combine(root, ownedPath);
+                        if (Path.Exists(entry) && (File.GetAttributes(entry) & FileAttributes.ReparsePoint) != 0)
+                            throw new InvalidDataException("隔离数据目录不能包含重定向。");
+                    }
+                    return root;
+                }
+            }
+        }
+        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException)
+        {
+            // 失败时退出，绝不回退到正常 DeskBox 数据目录。
+        }
+        Environment.Exit(2);
+        throw new InvalidOperationException("需要带标记的桌面格子隔离目录。");
+    }
+
+    private static bool IsRegularFile(string path) => File.Exists(path) &&
+        (File.GetAttributes(path) & FileAttributes.ReparsePoint) == 0;
+
+    private static bool NoReparseDirectories(string path)
+    {
+        for (DirectoryInfo? info = new(path); info is not null; info = info.Parent)
+        {
+            if (!info.Exists || (info.Attributes & FileAttributes.ReparsePoint) != 0)
+                return false;
+        }
+        return true;
+    }
+}
+#endif
diff --git a/src/DeskBox/Services/ReferenceGridRenderer.cs b/src/DeskBox/Services/ReferenceGridRenderer.cs
new file mode 100644
