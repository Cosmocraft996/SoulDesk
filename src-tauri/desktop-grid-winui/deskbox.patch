+    internal Snapshot State => _state;
+    internal bool HasPendingRequest => _submissions.CurrentCount == 0;
+    internal bool OwnerAlive => !_owner.HasExited;
+    internal bool Contains(string path) => _allowed.Contains(path);
+    internal IntPtr DesktopOwner
+    {
+        get
+        {
+            if (_state.DesktopLayer is not { } layer || layer.Handle == 0)
+                return IntPtr.Zero;
+            var hwnd = new IntPtr(layer.Handle);
+            Win32Helper.GetWindowThreadProcessId(hwnd, out uint pid);
+            if (pid != layer.Pid || layer.Session != _owner.SessionId)
+                return IntPtr.Zero;
+            var name = new StringBuilder(64);
+            if (Win32Helper.GetAncestor(hwnd, 2) != hwnd ||
+                Win32Helper.GetClassName(hwnd, name, name.Capacity) == 0 ||
+                name.ToString() is not ("Progman" or "WorkerW"))
+                return IntPtr.Zero;
+            var iconView = Win32Helper.FindWindowEx(hwnd, IntPtr.Zero, "SHELLDLL_DefView", null);
+            if (iconView == IntPtr.Zero || Win32Helper.GetWindowThreadProcessId(iconView, out uint viewPid) == 0 ||
+                viewPid != pid)
+                return IntPtr.Zero;
+            try
+            {
+                using var explorer = Process.GetProcessById(layer.Pid);
+                if (!explorer.HasExited && explorer.SessionId == layer.Session &&
+                    explorer.StartTime.ToUniversalTime().Ticks.ToString(CultureInfo.InvariantCulture) == _state.DesktopStarted)
+                    return hwnd;
+            }
+            catch (ArgumentException) { }
+            catch (InvalidOperationException) { }
+            catch (System.ComponentModel.Win32Exception) { }
+            return IntPtr.Zero;
+        }
+    }
