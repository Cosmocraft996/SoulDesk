+    }
+
+    private static WidgetConfig ReferenceConfig(ReferenceWindow item)
+    {
+        var config = new WidgetConfig
+        {
+            Id = item.Group, Name = item.Title, IsDefaultTitle = false, SortMode = item.Sort,
+            X = item.Bounds.X, Y = item.Bounds.Y, Width = item.Width, Height = item.Height, IsCollapsed = item.Collapsed,
+            IsSizeLocked = item.Saved?.LocksSize ?? false, IsPositionLocked = item.Saved?.LocksPosition ?? false,
+            ViewMode = item.View, SortDescending = item.Descending, MappedFolderPath = item.Tab?.Folder,
+            CompactWidth = item.Saved?.CapsuleWidth,
+            BoundsCoordinateVersion = WidgetConfig.CurrentBoundsCoordinateVersion,
