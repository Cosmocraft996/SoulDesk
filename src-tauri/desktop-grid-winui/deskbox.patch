@@ -0,0 +1,77 @@
+#if SOULDESK_GRID_PREVIEW
+using DeskBox.Models;
+using DeskBox.Services;
+
+namespace DeskBox.ViewModels;
+
+public partial class WidgetViewModel
+{
+    private bool _referenceGridHydrationEnabled;
+
+    internal void RefreshReferenceStackRules() => RebuildStackDisplayItems();
+
+    internal void ApplyReferenceStackSettings(Dictionary<string, string>? preferences)
+    {
+        if (!ReferenceGridPreview.ApplyMetadata(Config, ReferenceGridPreview.StackKeys, preferences)) return;
+        CleanupStacks();
+        InitializeStacks();
+        ApplyStackSettings();
+    }
+
+    private static IEnumerable<string> ReferenceDisplayPaths(IEnumerable<WidgetItem> items) =>
+        items.SelectMany(item => item is WidgetStackItem stack ? stack.Members.Select(member => member.Path) : [item.Path]);
+
+    internal void EnableReferenceGridHydration()
+    {
+        _referenceGridHydrationEnabled = true;
+        StartItemHydration();
+    }
+
+    internal void ApplyReferencePresentation(ViewMode view, WidgetSortMode sort, bool descending, bool stack)
+    {
+        if (ViewMode != view)
+            Config.ViewMode = ViewMode = view;
+        if (Config.SortMode != sort || Config.SortDescending != descending)
+        {
+            Config.SortMode = sort;
+            Config.SortDescending = descending;
+            SortItems();
+            OnPropertyChanged(nameof(SortModeLabel));
+        }
+        if (ReferenceGridPreview.UsesAutomaticStacks(Config) != stack)
+        {
+            ReferenceGridPreview.SetStackPreference(Config, stack);
+            RebuildStackDisplayItems();
+        }
+    }
+
+    internal async Task RefreshReferenceGridAsync(CancellationToken cancellationToken = default)
+    {
+        if (ReferenceGridPreview.Current is not { } workspace ||
+            !Config.Metadata.TryGetValue(ReferenceGridPreview.GroupKey, out string? group))
+            return;
+
+        var files = await Task.WhenAll(workspace.GetFiles(group).Select(path =>
+            _fileService.TryCreateWidgetItemAsync(path,
+                hideShortcutArrowOverlay: _hideShortcutArrowOverlay,
+                showImageFilesAsIcons: _showImageFilesAsIcons,
+                showFileExtensions: _showFileExtensions,
+                hideShortcutExtensionWhenShowingFileExtensions: _hideShortcutExtensionWhenShowingFileExtensions,
+                loadIcon: false,
+                loadFolderItemCount: false,
+                loadShortcutTarget: false)));
+        cancellationToken.ThrowIfCancellationRequested();
+
+        if (_isDisposed)
+            return;
+        // 始终按成员目录的次序投影，跨格子只替换引用。
+        Items.Clear();
+        foreach (var file in files.OfType<WidgetItem>())
+            Items.Add(file);
+        SortItems();
+        RebuildStackDisplayItems();
+        if (_referenceGridHydrationEnabled)
+            StartItemHydration();
+    }
+}
+#endif
diff --git a/src/DeskBox/Controls/WidgetContents/FileSurfaceContent.ReferenceGridPreview.cs b/src/DeskBox/Controls/WidgetContents/FileSurfaceContent.ReferenceGridPreview.cs
new file mode 100644
index 0000000..53aaffa
--- /dev/null
+++ b/src/DeskBox/Controls/WidgetContents/FileSurfaceContent.ReferenceGridPreview.cs
@@ -0,0 +1,175 @@
+#if SOULDESK_GRID_PREVIEW
+using DeskBox.Models;
+using DeskBox.Services;
+using DeskBox.ViewModels;
+using Microsoft.UI.Xaml;
+using Microsoft.UI.Xaml.Controls;
+using Windows.ApplicationModel.DataTransfer;
+using System.Runtime.CompilerServices;
+
+namespace DeskBox.Controls.WidgetContents;
+
+public sealed partial class FileSurfaceContent
+{
+    private const string ReferencePathPrefix = "SoulDesk.DesktopGrid.Path/1|";
+    private static readonly ConditionalWeakTable<DragEventArgs, object> s_referenceDropEvents = new();
+
+    private void ShowReferenceItemMenu(WidgetItem item, Windows.Foundation.Point pointer, ReferenceGridPreview workspace)
+    {
+        if (item is WidgetStackItem stack)
+        {
+            CreateStackFlyout(stack).ShowAt(Root, pointer);
+            return;
+        }
+        bool mapped = ViewModel.MappedFolderPath is not null;
+        if (!(mapped ? workspace.CanReadMappedFolder(item.Path) : workspace.IsFixturePath(item.Path)))
+            return;
+        var menu = new MenuFlyout();
+        var open = new MenuFlyoutItem { Text = "打开", Icon = new FontIcon { Glyph = "\uE8E5" } };
+        open.Click += async (_, _) =>
+        {
+            try
+            {
+                if (!item.IsFolder || !await ViewModel.NavigateIntoFolderAsync(item))
+                    await ViewModel.OpenItemAsync(item, IntPtr.Zero);
+            }
+            catch (Exception error) { App.Log($"打开格子项目失败 {error.Message}"); }
+        };
+        var reveal = new MenuFlyoutItem { Text = "定位原文件", Icon = new FontIcon { Glyph = "\uE8B7" } };
+        reveal.Click += (_, _) => ViewModel.ShowInExplorer(item);
+        var copy = new MenuFlyoutItem { Text = "复制原路径", Icon = new FontIcon { Glyph = "\uE8C8" } };
+        copy.Click += (_, _) => CopyPathsToClipboard([item]);
+        menu.Items.Add(open);
+        menu.Items.Add(reveal);
+        menu.Items.Add(copy);
+        var active = GetActiveItemsView();
+        if (!active.SelectedItems.Contains(item))
+        {
+            active.SelectedItems.Clear();
+            active.SelectedItems.Add(item);
+        }
+        var selected = GetSelectedItems().Where(member => member is not WidgetStackItem).ToArray();
+        if (ViewModel.FileStacksEnabled && selected.Length > 1)
+        {
+            var create = new MenuFlyoutItem { Text = "创建自定义堆栈", Icon = new FontIcon { Glyph = "\uE81E" } };
+            create.Click += (_, _) => ApplyStackProjectionChange(() => ViewModel.CreateManualStack(selected));
+            menu.Items.Add(create);
+        }
+        if (ViewModel.CanRemoveItemFromStack(item))
+        {
+            var unstack = new MenuFlyoutItem { Text = "移出堆栈", Icon = new FontIcon { Glyph = "\uE74D" } };
+            unstack.Click += (_, _) => ApplyStackProjectionChange(() => ViewModel.RemoveItemFromStack(item));
+            menu.Items.Add(unstack);
+        }
+        menu.Items.Add(CreateStackSettingsMenu());
+        if (!mapped)
+        {
+            var release = new MenuFlyoutItem { Text = "移出格子", Icon = new FontIcon { Glyph = "\uE74D" } };
+            release.Click += async (_, _) =>
+            {
+                try { await workspace.ReleaseAsync(WidgetId, item.Path); }
+                catch (Exception error) { App.Log($"移出格子失败 {error.Message}"); }
+            };
+            menu.Items.Add(new MenuFlyoutSeparator());
+            menu.Items.Add(release);
+        }
+        menu.ShowAt(Root, pointer);
+    }
+
+    private static DataPackageOperation ReferenceEffect(DataPackageOperation allowed) =>
+        allowed.HasFlag(DataPackageOperation.Link) ? DataPackageOperation.Link :
+        allowed.HasFlag(DataPackageOperation.Copy) ? DataPackageOperation.Copy : DataPackageOperation.None;
+
+    internal static void SetReferenceDropEffect(DragEventArgs args, WidgetViewModel model)
+    {
+        var paths = GetPackagePaths(args.DataView);
+        bool supported = ReferenceGridPreview.Current is { } workspace && paths.Any(workspace.IsFixturePath) ||
+            paths.Length == 0 && (args.DataView.Contains(StandardDataFormats.StorageItems) ||
+                args.AllowedOperations.HasFlag(DataPackageOperation.Link) && args.DataView.Contains(StandardDataFormats.Text));
+        args.AcceptedOperation = supported && model.MappedFolderPath is null
+            ? ReferenceEffect(args.AllowedOperations) : DataPackageOperation.None;
+        args.DragUIOverride.Caption = args.AcceptedOperation == DataPackageOperation.None ? "" : "添加到格子";
+        args.Handled = true;
+    }
+
+    private void ApplyReferenceDragOver(DragEventArgs args)
+    {
+        SetReferenceDropEffect(args, ViewModel);
+        if (args.AcceptedOperation != DataPackageOperation.None)
+            ApplyDropVisual(FileDropVisualState.Accept);
+        else
+            ApplyDropVisual(FileDropVisualState.None);
+    }
+
+    internal static Task ApplyReferenceHostDropAsync(WidgetViewModel model, DragEventArgs args) =>
+        ImportReferenceDropAsync(model, args, _ => null);
+
+    private async Task ApplyReferenceDropAsync(DragEventArgs args)
+    {
+        try
+        {
+            await ImportReferenceDropAsync(ViewModel, args,
+                paths => CaptureExternalDropInsertionIndex(paths, args.GetPosition(GetActiveItemsView())));
+        }
+        finally
+        {
+            ResetExternalDropPreview();
+            ApplyDropVisual(FileDropVisualState.None);
+        }
+    }
+
+    private static async Task ImportReferenceDropAsync(WidgetViewModel model, DragEventArgs args,
+        Func<string[], int?> insertion)
+    {
+        if (!s_referenceDropEvents.TryAdd(args, new object()))
+            return;
+        var deferral = args.GetDeferral();
+        args.Handled = true;
+        args.AcceptedOperation = DataPackageOperation.None;
+        string[] eligible;
+        int? index;
+        try
+        {
+            var effect = ReferenceEffect(args.AllowedOperations);
+            if (model.MappedFolderPath is not null || effect == DataPackageOperation.None ||
+                ReferenceGridPreview.Current is not { } workspace)
+                return;
+            var paths = GetPackagePaths(args.DataView);
+            if (paths.Length == 0 && args.AllowedOperations.HasFlag(DataPackageOperation.Link) &&
+                args.DataView.Contains(StandardDataFormats.Text))
+            {
+                try
+                {
+                    var text = await args.DataView.GetTextAsync();
+                    if (text.StartsWith(ReferencePathPrefix, StringComparison.Ordinal))
+                        paths = [text[ReferencePathPrefix.Length..]];
+                }
+                catch (System.Runtime.InteropServices.COMException error)
+                {
+                    App.Log($"读取桌面格子原路径拖放格式失败 {error.Message}");
+                }
+            }
+            if (paths.Length == 0 && args.DataView.Contains(StandardDataFormats.StorageItems))
+                paths = (await args.DataView.GetStorageItemsAsync()).Select(item => item.Path).ToArray();
+            eligible = paths.Where(workspace.IsFixturePath).ToArray();
+            if (eligible.Length == 0)
+                return;
+            index = insertion(eligible);
+            args.AcceptedOperation = effect;
+        }
+        catch (Exception error)
+        {
+            App.Log($"读取原地拖放项目失败 {error}");
+            return;
+        }
+        finally
+        {
+            deferral.Complete();
+        }
+
+        // 文件拖放源可能在 Windows 的拖放循环里，先完成系统回调再等待引擎确认。
+        try { await model.ImportPathsAsync(eligible, preferredManualIndex: index); }
+        catch (Exception error) { App.Log($"保存原地拖放项目失败 {error}"); }
+    }
+}
+#endif
