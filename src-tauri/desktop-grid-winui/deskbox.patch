+
+namespace DeskBox.Views;
+
+internal sealed class ReferenceSettingsWindow : Window
+{
+    private sealed record Editor(string Kind, string? Text, string[]? Options);
+    private sealed record Row(string Key, string Title, string? Description, string? Glyph, string? Route, Editor[]? Editors, Row[]? Children);
+    private sealed record Page(string Title, string? Parent, string Nav, Row[] Rows);
+    private sealed record Nav(string Tag, string Title, string? Icon);
+    private sealed record Catalog(Nav[] Navigation, Dictionary<string, Page> Pages);
+    private sealed record Match(string Tag, string Title, string Category)
+    {
+        public override string ToString() => Title == Category ? Title : $"{Title}  ·  {Category}";
+    }
+
+    private const string Unavailable = "暂未接入 SoulDesk";
+    private readonly ReferenceGridRenderer _renderer;
+    private readonly Catalog _catalog;
+    private readonly NavigationView _navigation;
+    private readonly ScrollViewer _scroll;
+    private readonly StackPanel _content;
+    private readonly InfoBar _failure;
+    private readonly List<Action<ReferenceGridRenderer.Snapshot>> _readers = [];
+    private readonly Dictionary<string, NavigationViewItem> _items = new(StringComparer.Ordinal);
+    private string _page = "General";
+    private bool _selectingPage, _applyingState;
+
+    internal ReferenceSettingsWindow(ReferenceGridRenderer renderer)
+    {
+        _renderer = renderer;
+        using var source = typeof(ReferenceSettingsWindow).Assembly.GetManifestResourceStream(
+            "DeskBox.ReferenceSettingsCatalog.json") ?? throw new InvalidDataException("设置目录缺失。");
+        _catalog = JsonSerializer.Deserialize<Catalog>(source) ?? throw new InvalidDataException("设置目录无效。");
+        Title = "SoulDesk · 设置";
+        SystemBackdrop = new MicaBackdrop();
+        double scale = Win32Helper.GetDpiScaleForWindow(WinRT.Interop.WindowNative.GetWindowHandle(this), null);
+        var display = Microsoft.UI.Windowing.DisplayArea.GetFromWindowId(AppWindow.Id,
+            Microsoft.UI.Windowing.DisplayAreaFallback.Nearest);
+        var work = display.WorkArea;
+        int width = Math.Min(work.Width, (int)Math.Round(1040 * scale));
+        int height = Math.Min(work.Height, (int)Math.Round(720 * scale));
+        AppWindow.MoveAndResize(new RectInt32(work.X + (work.Width - width) / 2,
+            work.Y + (work.Height - height) / 2, width, height));
+        var root = new Grid { MinWidth = 620, MinHeight = 440 };
+        root.Resources.MergedDictionaries.Add(new ResourceDictionary
+        {
+            Source = new Uri("ms-appx:///Styles/SettingsOverviewResources.xaml"),
+        });
+        root.Resources["NavigationViewItemOnLeftMinHeight"] = 42d;
+        root.Resources["NavigationViewItemButtonMargin"] = new Thickness(4, 1, 4, 1);
+
+        var search = new AutoSuggestBox { PlaceholderText = "搜索设置", QueryIcon = new SymbolIcon(Symbol.Find),
+            MinWidth = 260, MaxWidth = 520, CornerRadius = new CornerRadius(16) };
+        var titleBar = new TitleBar { Title = "SoulDesk", Content = search };
+        _navigation = new NavigationView
+        {
+            PaneDisplayMode = NavigationViewPaneDisplayMode.Left, IsPaneOpen = true,
+            OpenPaneLength = 224, CompactPaneLength = 58, IsSettingsVisible = false,
+            IsBackButtonVisible = NavigationViewBackButtonVisible.Collapsed,
+        };
+        foreach (var entry in _catalog.Navigation)
+        {
+            var item = new NavigationViewItem { Content = entry.Title, Tag = entry.Tag };
+            if (entry.Icon is { } icon)
+                item.Icon = new ImageIcon { Width = 28, Height = 28, Source = new SvgImageSource(new Uri(icon)) };
+            _items.Add(entry.Tag, item);
+            _navigation.MenuItems.Add(item);
+        }
+        _navigation.SelectionChanged += (_, args) =>
+        {
+            if (!_selectingPage && args.SelectedItem is NavigationViewItem { Tag: string tag })
+                Navigate(tag);
+        };
+        _navigation.BackRequested += (_, _) =>
+        {
+            if (_catalog.Pages[_page].Parent is { } parent) Navigate(parent);
+        };
+        var matches = _catalog.Pages.SelectMany(entry =>
+            new[] { new Match(entry.Key, entry.Value.Title, entry.Value.Title) }.Concat(
+                Enumerate(entry.Value.Rows).Select(row => new Match(entry.Key, row.Title, entry.Value.Title)))).ToArray();
+        search.TextChanged += (_, args) =>
+        {
+            if (args.Reason == AutoSuggestionBoxTextChangeReason.UserInput)
+                search.ItemsSource = string.IsNullOrWhiteSpace(search.Text) ? [] : matches.Where(match =>
+                    match.Title.Contains(search.Text.Trim(), StringComparison.CurrentCultureIgnoreCase)).Distinct().Take(20).ToArray();
+        };
+        search.QuerySubmitted += (_, args) =>
+        {
+            if (string.IsNullOrWhiteSpace(args.QueryText)) return;
+            var match = args.ChosenSuggestion as Match ?? matches.FirstOrDefault(item =>
+                item.Title.Contains(args.QueryText.Trim(), StringComparison.CurrentCultureIgnoreCase));
+            if (match is not null) Navigate(match.Tag);
+        };
+        _content = new StackPanel { Spacing = 4, MaxWidth = 760, HorizontalAlignment = HorizontalAlignment.Stretch,
+            Margin = new Thickness(34, 14, 44, 24) };
+        _scroll = new ScrollViewer { Content = _content, VerticalScrollBarVisibility = ScrollBarVisibility.Auto };
+        _failure = new InfoBar { Severity = InfoBarSeverity.Error, Title = "设置未保存", IsClosable = true };
+        var host = new Grid();
+        host.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
+        host.RowDefinitions.Add(new RowDefinition { Height = new GridLength(1, GridUnitType.Star) });
+        host.Children.Add(_failure);
+        Grid.SetRow(_scroll, 1);
+        host.Children.Add(_scroll);
+        _navigation.Content = host;
+        root.RowDefinitions.Add(new RowDefinition { Height = GridLength.Auto });
+        root.RowDefinitions.Add(new RowDefinition { Height = new GridLength(1, GridUnitType.Star) });
+        root.Children.Add(titleBar);
+        Grid.SetRow(_navigation, 1);
+        root.Children.Add(_navigation);
+        Content = root;
+        ExtendsContentIntoTitleBar = true;
+        SetTitleBar(titleBar);
+        Navigate(_renderer.State.SettingsPage ?? "General");
+    }
+
+    private static IEnumerable<Row> Enumerate(IEnumerable<Row> rows)
+    {
+        foreach (var row in rows)
+        {
+            yield return row;
+            foreach (var child in Enumerate(row.Children ?? [])) yield return child;
+        }
+    }
+
+    internal void Present()
+    {
+        if (_renderer.State.SettingsPage is { } tag && tag != _page)
+            Navigate(tag);
+        Activate();
+        Win32Helper.SetForegroundWindow(WinRT.Interop.WindowNative.GetWindowHandle(this));
+    }
+
+    internal void ApplySnapshot()
+    {
+        _applyingState = true;
+        try { foreach (var read in _readers) read(_renderer.State); }
+        finally { _applyingState = false; }
+    }
+
+    internal async Task<object> VerifyIsolatedSettingsAsync()
+    {
+        int rows = 0, disabled = 0;
+        foreach (string tag in _catalog.Pages.Keys)
+        {
+            Navigate(tag);
+            if (_content.Children.Count <= 1)
+                throw new InvalidDataException($"设置页 {tag} 没有显示任何设置。");
+            rows += _content.Children.Count - 1;
+            disabled += _content.Children.OfType<SettingsCard>().Count(card =>
+                card.Description is string description && description.Contains(Unavailable, StringComparison.Ordinal));
+        }
+        Navigate("CapsuleMode");
+        var toggle = _content.Children.OfType<SettingsExpander>().Select(card => card.Content).OfType<ToggleSwitch>()
+            .Single(option => AutomationProperties.GetName(option) == "排列方式");
+        toggle.IsOn = true;
+        using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(8));
+        while (_renderer.State.CapsuleBar != "Horizontal")
+            await Task.Delay(100, timeout.Token);
+        Navigate("FileDisplaySettings");
+        var extensions = _content.Children.OfType<SettingsExpander>().Select(card => card.Content).OfType<ToggleSwitch>()
+            .Single(option => AutomationProperties.GetName(option) == "显示文件后缀名");
+        extensions.IsOn = true;
+        while (_renderer.State.Preferences?.GetValueOrDefault("ShowFileExtensions") != "true")
+            await Task.Delay(100, timeout.Token);
+        return new
+        {
+            categories = _navigation.MenuItems.OfType<NavigationViewItem>().Select(item => item.Content).ToArray(),
+            pages = _catalog.Pages.Count, rows, disabled, capsuleBar = _renderer.State.CapsuleBar
+        };
+    }
+
+    private void Navigate(string tag)
+    {
+        if (!_catalog.Pages.TryGetValue(tag, out var page)) return;
+        _page = tag;
+        _selectingPage = true;
+        try { _navigation.SelectedItem = _items[page.Nav]; }
+        finally { _selectingPage = false; }
+        _navigation.IsBackButtonVisible = page.Parent is null ? NavigationViewBackButtonVisible.Collapsed :
+            NavigationViewBackButtonVisible.Visible;
+        _readers.Clear();
+        _content.Children.Clear();
+        var heading = new TextBlock { Text = page.Parent is null ? page.Title : $"{_catalog.Pages[page.Parent].Title}  ›  {page.Title}",
+            FontSize = 28, FontWeight = Microsoft.UI.Text.FontWeights.SemiBold, Margin = new Thickness(0, 0, 0, 12) };
+        AutomationProperties.SetHeadingLevel(heading, AutomationHeadingLevel.Level1);
+        _content.Children.Add(heading);
+        foreach (var row in page.Rows) _content.Children.Add(CreateRow(row));
+        if (tag == "DesktopOrganizationSettings")
+            _content.Children.Add(CreateRow(new("souldesk-public", "包含公共桌面", "整理时同时检查公共桌面。",
+                "\uE716", null, null, null)));
+        if (tag == "SearchSettings")
+            _content.Children.Add(CreateRow(new("souldesk-search-index", "Windows 搜索索引", "补充已建立索引的文件结果。",
+                "\uE721", null, null, null)));
+        if (tag == "Interaction")
+            _content.Children.Add(CreateRow(new("souldesk-coordinated", "联动拖动", "按住 Ctrl 拖动当前显示器上的桌面格子。",
+                "\uE8AB", null, null, null)));
+        if (tag == "Displays")
+            _content.Children.Add(CreateRow(new("souldesk-displays", "显示器绑定", "在管理窗口为每个格子选择显示器。",
+                "\uE7F4", null, null, null)));
+        ApplySnapshot();
+        _scroll.ChangeView(null, 0, null, disableAnimation: true);
+    }
+
+    private FrameworkElement CreateRow(Row row)
+    {
+        var editor = ConnectedEditor(row.Key);
+        if (editor is not null) AutomationProperties.SetName(editor, row.Title);
+        var childRows = row.Children ?? [];
+        var definition = row.Editors ?? [];
+        bool group = row.Route is not null || childRows.Length > 0;
+        bool unavailable = editor is null && (!group || definition.Length > 0);
+        string description = row.Description ?? "";
+        if (unavailable)
+            description = description.Length > 0 ? $"{description} · {Unavailable}" : Unavailable;
+        if (editor is null && unavailable)
+            editor = DisabledEditors(row.Title, definition);
+        var glyph = row.Glyph is { Length: > 0 } code ? new FontIcon { Glyph = code } : null;
+        if (childRows.Length > 0)
+        {
+            var expander = new SettingsExpander { Header = row.Title, Description = description, HeaderIcon = glyph, Content = editor };
+            foreach (var child in childRows) expander.Items.Add(CreateRow(child));
+            return expander;
+        }
+        var card = new SettingsCard
+        {
+            Header = row.Title, Description = description, HeaderIcon = glyph, Content = editor,
+            HorizontalContentAlignment = HorizontalAlignment.Right, IsClickEnabled = row.Route is not null,
+        };
+        if (row.Route is { } route)
+            card.Click += (_, _) => Navigate(route);
+        return card;
+    }
+
+    private static FrameworkElement? DisabledEditors(string title, Editor[] editors)
+    {
+        var controls = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 8 };
+        foreach (var editor in editors)
+        {
+            Control input = editor.Kind switch
+            {
+                "Toggle" => new ToggleSwitch { OnContent = "", OffContent = "" },
+                "Choice" => new ComboBox { ItemsSource = editor.Options, MinWidth = 176, PlaceholderText = Unavailable },
+                "Slider" => new Slider { Width = 176 },
+                "Number" => new NumberBox { Width = 108 },
+                "Text" => new TextBox { Width = 176, PlaceholderText = Unavailable },
+                _ => new Button { Content = editor.Text ?? "打开" },
+            };
+            input.IsEnabled = false;
+            AutomationProperties.SetName(input, editor.Text ?? title);
+            AutomationProperties.SetHelpText(input, Unavailable);
+            controls.Children.Add(input);
+        }
+        return controls.Children.Count > 0 ? controls : null;
+    }
+
+    private FrameworkElement? ConnectedEditor(string key)
+    {
+        var preference = _renderer.State.PreferenceRows?.FirstOrDefault(option => option.Row == key);
+        return preference is not null ? PreferenceEditor(preference) : ExistingEditor(key);
+    }
+
+    private FrameworkElement PreferenceEditor(ReferenceGridRenderer.Preference option)
+    {
+        string Read(ReferenceGridRenderer.Snapshot state) => ReferenceGridPreferences.Read(state, option.Key);
+        if (option.Values is { } values && option.Labels is { } labels)
+            return Choice(option.Key, Read, values.Zip(labels).ToArray());
+        if (option.Kind == "toggle")
+            return Toggle(option.Key, state => Read(state) == "true", value => value ? "true" : "false");
+        if (option.Kind == "color")
+        {
+            var color = new TextBox { Width = 108, MaxLength = 7, PlaceholderText = "#RRGGBB" };
+            _readers.Add(state =>
+            {
+                color.IsEnabled = option.Key switch
+                {
+                    "CustomAccentColor" => ReferenceGridPreferences.Read(state, "AccentColorMode") == "Custom",
+                    "WidgetForegroundColor" => ReferenceGridPreferences.Read(state, "WidgetForegroundMode") == "Custom",
+                    _ => true
+                };
+                if (color.FocusState == FocusState.Unfocused) color.Text = Read(state);
+            });
+            color.LostFocus += async (_, _) =>
+            {
+                if (!_applyingState && color.Text != Read(_renderer.State))
+                    await SubmitAsync(option.Key, color.Text.Length == 0 ? null : color.Text);
+            };
+            return color;
+        }
+
+        var number = new NumberBox { Width = 124, Minimum = option.Min, Maximum = option.Max,
+            SmallChange = option.Step, LargeChange = option.Step * 5,
+            SpinButtonPlacementMode = NumberBoxSpinButtonPlacementMode.Compact };
+        _readers.Add(state => number.Value = double.Parse(Read(state), CultureInfo.InvariantCulture));
+        number.ValueChanged += async (_, args) =>
+        {
+            if (!_applyingState && double.IsFinite(args.NewValue))
+            {
+                double value = option.Kind == "integer" ? Math.Round(args.NewValue) : args.NewValue;
+                await SubmitAsync(option.Key, value.ToString("0.##", CultureInfo.InvariantCulture));
+            }
+        };
+        return number;
+    }
+
+    private FrameworkElement? ExistingEditor(string key) => key switch
+    {
+        "Settings.CollapseBehavior.Title" => Choice("default-collapse", s => s.DefaultCollapseMode,
+            [("Smart", "悬停自动展开"), ("Click", "单击展开"), ("Expanded", "始终展开")]),
+        "Settings.Capsule.Arrangement.Title" => Toggle("capsule-bar", s => s.CapsuleBar is not null,
+            value => value ? _renderer.State.CapsuleBar ?? "Horizontal" : null),
+        "Settings.Capsule.Direction.Title" => Choice("capsule-bar", s => s.CapsuleBar ?? "Horizontal",
+            [("Horizontal", "横向排列"), ("Vertical", "纵向排列")]),
+        "Settings.Capsule.Spacing.Title" => Spacing(),
+        "DesktopOrganization.Auto.Title" => Toggle("auto-sort", s => s.AutoSort),
+        "souldesk-public" => Toggle("include-public", s => s.IncludePublic),
+        "souldesk-coordinated" => Toggle("coordinated-move", s => s.CoordinatedMove),
+        "souldesk-search-index" when !_renderer.State.Isolated => Toggle("search-index", s => s.SearchIndexed),
+        "Settings.FileStacks.Custom.Rules.Title" => Command("编辑规则", "stack-rules"),
+        "DesktopOrganization.Settings.Title" or "DesktopOrganization.OneClick.Action" =>
+            Command("整理桌面", "organization"),
+        "souldesk-displays" or "Settings.Displays.Title" => Command("管理格子", "manager"),
+        "Settings.Displays.MoveAll" => Command("选择显示器", "display-move-all"),
+        "Settings.Displays.NewWidgets.Header" => NewWidgetMonitor(),
+        "Settings.Capsule.Overrides.ResetAll.Title" => Command("全部恢复", "capsule-overrides-reset"),
+        "Settings.WidgetBackground.PerWidget.Title" => Command("清除独立背景", "background-clear-overrides"),
+        "Settings.WidgetBackground.Image.Title" => BackgroundImageActions(),
+        "DesktopOrganization.Notification.Undo" => Command("查看历史", "organization-history"),
+        "DesktopOrganization.Auto.SetupTitle" => Command("打开整理", "organization"),
+        "DesktopOrganization.Rule.Enable.Title" or "DesktopOrganization.Rule.Extensions" =>
+            Command("编辑当前格子规则", "organization-rule"),
+        "Settings.Search.Everything.Title" when !_renderer.State.Isolated => EverythingActions(),
+        "Settings.DataBackup.Export" => BackupActions(),
+        _ => null,
+    };
+
+    private ComboBox NewWidgetMonitor()
+    {
+        var combo = new ComboBox { MinWidth = 210 };
+        var choices = Array.Empty<(string? Value, string Title)>();
+        _readers.Add(state =>
+        {
+            (string? Value, string Title)[] options =
+            [
+                (null, "主屏（允许移动）"), ("@cursor", "鼠标所在屏幕"), ("@primary", "始终在主屏"),
+                .. (state.Displays ?? []).Select(display => ((string?)display.Id, display.Name))
+            ];
+            if (!options.Any(item => item.Value == state.NewWidgetMonitor))
+                options = [.. options, (state.NewWidgetMonitor, "指定显示器已离线")];
+            if (!choices.SequenceEqual(options))
+            {
+                choices = options;
+                combo.ItemsSource = choices.Select(item => item.Title).ToArray();
+            }
+            combo.SelectedIndex = Array.FindIndex(choices, item => item.Value == state.NewWidgetMonitor);
+        });
+        combo.SelectionChanged += async (_, _) =>
+        {
+            if (!_applyingState && combo.SelectedIndex >= 0)
+                await SubmitAsync("new-widget-monitor", choices[combo.SelectedIndex].Value);
+        };
+        return combo;
+    }
+
+    private ToggleSwitch Toggle(string key, Func<ReferenceGridRenderer.Snapshot, bool> read, Func<bool, string?>? map = null)
+    {
+        var toggle = new ToggleSwitch { OnContent = "", OffContent = "", MinWidth = 0 };
+        _readers.Add(state => toggle.IsOn = read(state));
+        toggle.Toggled += async (_, _) =>
+        {
+            if (!_applyingState) await SubmitAsync(key, map is null ? toggle.IsOn.ToString() : map(toggle.IsOn));
+        };
+        return toggle;
+    }
+
+    private ComboBox Choice(string key, Func<ReferenceGridRenderer.Snapshot, string?> read, (string Value, string Title)[] items)
+    {
+        var combo = new ComboBox { MinWidth = 176, ItemsSource = items.Select(item => item.Title).ToArray() };
+        _readers.Add(state =>
+        {
+            combo.SelectedIndex = Array.FindIndex(items, item => item.Value == read(state));
+            if (key == "capsule-bar") combo.IsEnabled = state.CapsuleBar is not null;
+        });
+        combo.SelectionChanged += async (_, _) =>
+        {
+            if (!_applyingState && combo.SelectedIndex >= 0) await SubmitAsync(key, items[combo.SelectedIndex].Value);
+        };
+        return combo;
+    }
+
+    private NumberBox Spacing()
+    {
+        var spacing = new NumberBox { Minimum = 0, Maximum = 32, SmallChange = 1, Width = 108,
+            SpinButtonPlacementMode = NumberBoxSpinButtonPlacementMode.Compact };
+        _readers.Add(state => { spacing.Value = state.CapsuleSpacing; spacing.IsEnabled = state.CapsuleBar is not null; });
+        spacing.ValueChanged += async (_, args) =>
+        {
+            if (!_applyingState && double.IsFinite(args.NewValue))
+                await SubmitAsync("capsule-spacing", ((int)Math.Round(args.NewValue)).ToString(CultureInfo.InvariantCulture));
+        };
+        return spacing;
+    }
+
+    private Button Command(string title, string command)
+    {
+        var button = new Button { Content = title };
+        button.Click += async (_, _) => await SubmitAsync(command, null, "settings-show");
+        return button;
+    }
+
+    private StackPanel EverythingActions()
+    {
+        var choose = Command("选择 es.exe", "everything-pick");
+        var clear = new Button { Content = "清除" };
+        var actions = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 8 };
+        clear.Click += async (_, _) => await SubmitAsync("everything-clear", null);
+        _readers.Add(state =>
+        {
+            clear.IsEnabled = state.EverythingCli is not null;
+            ToolTipService.SetToolTip(choose, state.EverythingCli ?? "未配置 Everything 命令行");
+        });
+        actions.Children.Add(choose);
+        actions.Children.Add(clear);
+        return actions;
+    }
+
+    private StackPanel BackgroundImageActions()
+    {
+        var choose = new Button { Content = "选择图片" };
+        var clear = new Button { Content = "清除" };
+        var actions = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 8 };
+        actions.Children.Add(choose);
+        actions.Children.Add(clear);
+        bool Panorama(ReferenceGridRenderer.Snapshot state) =>
+            ReferenceGridPreferences.Read(state, "WidgetBackgroundMode") == "Panorama";
+        string Property(ReferenceGridRenderer.Snapshot state) =>
+            Panorama(state) ? "WidgetBackgroundPanoramaImage" : "WidgetBackgroundUnifiedImage";
+        _readers.Add(state =>
+        {
+            choose.IsEnabled = ReferenceGridPreferences.Read(state, "WidgetBackgroundMode") != "Material";
+            string? file = state.Preferences?.GetValueOrDefault(Property(state));
+            clear.IsEnabled = choose.IsEnabled && file is not null;
+            ToolTipService.SetToolTip(choose, file);
+        });
+        clear.Click += async (_, _) => await SubmitAsync(Property(_renderer.State), null);
+        choose.Click += async (_, _) =>
+        {
+            choose.IsEnabled = false;
+            try
+            {
+                string? path = await FileOpenPickerService.PickSingleFileAsync(WinRT.Interop.WindowNative.GetWindowHandle(this),
+                    [".png", ".jpg", ".jpeg", ".bmp", ".ico", ".svg"], PickerLocationId.PicturesLibrary);
+                if (path is null) return;
+                var snapshot = _renderer.State;
+                bool panorama = Panorama(snapshot);
+                var assets = WidgetTitleIconAssetStore.Current;
+                var result = panorama ? await assets.CopyPanoramaBackgroundImageAsync(path)
+                    : await assets.CopyUnifiedBackgroundImageAsync(path);
+                if (result != WidgetTitleIconAssetResult.Copied)
+                    throw new InvalidOperationException(result switch
+                    {
+                        WidgetTitleIconAssetResult.TooLarge => "背景图片超过大小限制。",
+                        WidgetTitleIconAssetResult.UnsupportedFormat => "不支持此图片格式。",
+                        _ => "无法读取背景图片。"
+                    });
+                await SubmitAsync(Property(snapshot), panorama ? WidgetTitleIconAssetStore.GetStoredPanoramaFileName(path)
+                    : WidgetTitleIconAssetStore.GetStoredBackgroundFileName(path));
+            }
+            catch (Exception error)
+            {
+                _failure.Message = error.Message;
+                _failure.IsOpen = true;
+            }
+            finally { ApplySnapshot(); }
+        };
+        return actions;
+    }
+
+    private StackPanel BackupActions()
+    {
+        var actions = new StackPanel { Orientation = Orientation.Horizontal, Spacing = 8 };
+        actions.Children.Add(Command("导出布局", "backup-export"));
+        actions.Children.Add(Command("导入布局", "backup-import"));
+        return actions;
+    }
+
+    private async Task SubmitAsync(string key, string? value, string action = "settings-edit")
+    {
+        try
+        {
+            if (!await _renderer.SubmitSettingAsync(action, "", "", key, value))
+                throw new InvalidOperationException("桌面格子会话已关闭。");
+            _failure.IsOpen = false;
+        }
+        catch (Exception error)
+        {
+            _failure.Message = error.Message;
+            _failure.IsOpen = true;
+        }
+        finally
+        {
+            try
+            {
+                _renderer.Refresh();
+                App.Current.ApplyReferencePreferences(_renderer.State);
+                ApplySnapshot();
+            }
+            catch (Exception error) { App.Log($"设置状态刷新失败 {error.Message}"); }
+        }
+    }
+}
+#endif
