+        using var input = new FileStream(Path.Combine(_directory, "state.json"),
+            FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
+        if (input.Length > 4 * 1024 * 1024)
+            throw new InvalidDataException("SoulDesk 格子布局超过 4 MiB。");
+        return JsonSerializer.Deserialize<Snapshot>(input)
+            ?? throw new InvalidDataException("SoulDesk 格子布局为空。");
+    }
