+        WidgetCollapseBehaviorNames.SetOverride(config, item.Mode);
+        WidgetCompactExpansionDirectionPolicy.SetOverride(config, item.Saved?.ExpansionDirection);
+        FileWidgetFolderOpenBehaviorNames.SetOverride(config, item.Tab?.FolderOpen);
+        ReferenceGridPreview.SetStackPreference(config, item.Tab?.StackByType ?? false);
+        ReferenceGridPreview.SetAppearance(config, item.Saved?.Color, item.Saved?.Opacity ?? 90);
+        ReferenceGridPreview.ApplyMetadata(config, ReferenceGridPreview.StackKeys, item.Tab?.StackSettings);
+        ReferenceGridPreview.ApplyMetadata(config, ReferenceGridPreview.ArtworkKeys, item.Tab?.Artwork,
+            WidgetBackgroundCustomization.ColorMetadataKey);
