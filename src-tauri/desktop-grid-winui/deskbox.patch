diff --git a/src/DeskBox/Services/ReferenceGridPreferences.cs b/src/DeskBox/Services/ReferenceGridPreferences.cs
new file mode 100644
index 0000000..807d29f
--- /dev/null
+++ b/src/DeskBox/Services/ReferenceGridPreferences.cs
@@ -0,0 +1,89 @@
+#if SOULDESK_GRID_PREVIEW
+using System.Globalization;
+using System.Reflection;
+using DeskBox.Contracts;
+using DeskBox.Models;
+
+namespace DeskBox.Services;
+
+internal static class ReferenceGridPreferences
+{
+    private static readonly AppSettings Defaults = CreateDefaults();
+
+    private static AppSettings CreateDefaults()
+    {
+        var settings = new AppSettings();
+        SettingsService.ApplyDefaultPreferences(settings);
+        settings.WidgetOpacity = 0.90;
+        settings.DefaultWidgetWidth = 324;
+        return settings;
+    }
+
+    private static PropertyInfo? Property(string key) =>
+        typeof(AppSettings).GetProperty(key, BindingFlags.Instance | BindingFlags.Public);
+
+    internal static string Read(ReferenceGridRenderer.Snapshot state, string key)
+    {
+        if (key == "CompactHoverResponse")
+            return CapsuleOptionKinds.ResolveHoverResponse(
+                int.Parse(Read(state, "WidgetCompactExpandDelayMs"), CultureInfo.InvariantCulture),
+                int.Parse(Read(state, "WidgetCompactCollapseDelayMs"), CultureInfo.InvariantCulture));
+        if (state.Preferences?.TryGetValue(key, out var value) == true)
+            return value;
+        if (key is "WidgetCompactExpandDelayMs" or "WidgetCompactCollapseDelayMs" &&
+            state.Preferences?.TryGetValue("CompactHoverResponse", out var response) == true &&
+            CapsuleOptionKinds.HoverResponsePresetDelays(response) is { } delays)
+            return (key == "WidgetCompactExpandDelayMs" ? delays.Expand : delays.Collapse).ToString(CultureInfo.InvariantCulture);
+        if (LayoutDensityKinds.TryGetPresetValues(state.Preferences?.GetValueOrDefault("LayoutDensity"), out var preset))
+        {
+            double? number = key switch
+            {
+                "IconSize" => preset.IconSize,
+                "TextSize" => preset.TextSize,
+                "LayoutDensityScale" => preset.DensityScale,
+                "HorizontalSpacingScale" => preset.HorizontalSpacingScale,
+                "VerticalSpacingScale" => preset.VerticalSpacingScale,
+                "FileNameWidthScale" => preset.FileNameWidthScale,
+                _ => null
+            };
+            if (number is { } presetValue) return presetValue.ToString(CultureInfo.InvariantCulture);
+        }
+
+        return key switch
+        {
+            "AutoSortDelaySeconds" => "4",
+            _ => Property(key)?.GetValue(Defaults) switch
+            {
+                bool enabled => enabled ? "true" : "false",
+                null when key == "WidgetBackgroundMode" => WidgetBackgroundModeKinds.Material,
+                null when key == "WidgetBackgroundUnifiedFit" => WidgetBackgroundKinds.FitFill,
+                null when key == "WidgetBackgroundDim" => WidgetBackgroundKinds.DefaultDimPercent.ToString(CultureInfo.InvariantCulture),
+                IFormattable number => number.ToString(null, CultureInfo.InvariantCulture),
+                string text => text,
+                _ => ""
+            }
+        };
+    }
+
+    internal static bool Apply(AppSettings settings, ReferenceGridRenderer.Snapshot state)
+    {
+        bool changed = false;
+        foreach (var option in state.PreferenceRows ?? [])
+        {
+            if (Property(option.Key) is not { CanWrite: true } property)
+                continue;
+            string value = Read(state, option.Key);
+            Type type = Nullable.GetUnderlyingType(property.PropertyType) ?? property.PropertyType;
+            object? next = option.Kind == "image" && value.Length == 0 ? null :
+                type == typeof(string) ? value :
+                type == typeof(int) ? (int)double.Parse(value, CultureInfo.InvariantCulture) :
+                Convert.ChangeType(value, type, CultureInfo.InvariantCulture);
+            if (Equals(property.GetValue(settings), next))
+                continue;
+            property.SetValue(settings, next);
+            changed = true;
+        }
+        return changed;
+    }
+}
+#endif
