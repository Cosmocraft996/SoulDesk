+    private async Task<Snapshot?> SendAsync(string action, string? tab, string[] paths, string? before,
+        string? box, bool? collapsed, RectInt32? bounds, string? target, string[]? expectedTabs, string? collapseMode,
+        CancellationToken cancellationToken, string? setting = null, string? value = null, double? capsuleWidth = null,
