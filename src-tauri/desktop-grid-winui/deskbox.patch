diff --git a/src/DeskBox/App.ReferenceLayout.cs b/src/DeskBox/App.ReferenceLayout.cs
new file mode 100644
index 0000000..005a657
--- /dev/null
+++ b/src/DeskBox/App.ReferenceLayout.cs
@@ -0,0 +1,156 @@
+#if SOULDESK_GRID_PREVIEW
+using DeskBox.Models;
+using DeskBox.Services;
+using DeskBox.Views;
+using Microsoft.UI.Windowing;
+using System.Text.Json;
+using Windows.Graphics;
+
+namespace DeskBox;
+
+public partial class App
+{
+    private (ContentWidgetWindow Window, RectInt32 Bounds)[]? _referenceMove;
+    private Dictionary<string, RectInt32>? _referenceMoveCommit;
+    private readonly Dictionary<string, RectInt32> _referenceCapsules = new(StringComparer.Ordinal);
+    private string? _referenceStackRules;
+
+    private void UpdateReferenceStackRules(ReferenceGridRenderer.Snapshot state)
+    {
+        var rules = state.StackRules ?? [];
+        string signature = JsonSerializer.Serialize(rules);
+        if (_referenceStackRules == signature) return;
+        _referenceStackRules = signature;
+        SettingsService.Settings.FileStackCustomRules = rules.Select(rule => new FileStackCustomRule
+        {
+            Id = rule.Id, Name = rule.Name, Extensions = [.. rule.Extensions]
+        }).ToList();
+        foreach (var item in _referenceWindows)
+            item.Content.ViewModel.RefreshReferenceStackRules();
+    }
+
+    private static DisplayArea ReferenceDisplay(RectInt32 bounds) => DisplayArea.GetFromPoint(
+        new PointInt32(bounds.X + bounds.Width / 2, bounds.Y + bounds.Height / 2), DisplayAreaFallback.Nearest);
+
+    internal bool BeginReferenceCoordinatedMove(IntPtr sourceHandle)
+    {
+        if (_referenceMove is not null || _referenceGrid?.Renderer?.State is not { CoordinatedMove: true, Visible: true })
+            return false;
+        var source = _referenceWindows.FirstOrDefault(entry => entry.Window.WindowHandle == sourceHandle).Window;
+        if (source is null || !source.CanParticipateInCoordinatedMove) return false;
+        var display = ReferenceDisplay(source.CoordinatedMoveBounds).DisplayId;
+        var entries = _referenceWindows.Where(entry => entry.Window.CanParticipateInCoordinatedMove &&
+                ReferenceDisplay(entry.Window.CoordinatedMoveBounds).DisplayId == display)
+            .Select(entry => (entry.Window, entry.Window.CoordinatedMoveBounds)).ToArray();
+        if (entries.Length < 2) return false;
+        _referenceMove = entries;
+        foreach (var (window, _) in entries)
+            window.BeginCoordinatedMoveParticipation(window.WindowHandle == sourceHandle);
+        return true;
+    }
+
+    internal bool UpdateReferenceCoordinatedMove(int dx, int dy)
+    {
+        if (_referenceMove is not { } entries) return false;
+        var start = WidgetCoordinatedMoveCalculator.GetUnion(entries.Select(entry => entry.Bounds));
+        var delta = WidgetCoordinatedMoveCalculator.ClampDelta(start, new PointInt32(dx, dy), ReferenceDisplay(start).WorkArea);
+        foreach (var (window, original) in entries)
+        {
+            var moved = new RectInt32(original.X + delta.X, original.Y + delta.Y, original.Width, original.Height);
+            window.PrepareCoordinatedMoveBounds(moved);
+            try { window.ApplyCoordinatedMoveBoundsFallback(moved); }
+            finally { window.CompleteCoordinatedMoveBoundsPreview(); }
+        }
+        return true;
+    }
+
+    internal bool CompleteReferenceCoordinatedMove(IntPtr source, bool moved)
+    {
+        if (_referenceMove is not { } entries) return false;
+        _referenceMove = null;
+        _referenceMoveCommit = new Dictionary<string, RectInt32>(StringComparer.Ordinal);
+        try
+        {
+            foreach (var (window, _) in entries)
+                window.CompleteCoordinatedMoveParticipation(moved, window.WindowHandle == source);
+            if (_referenceMoveCommit.Count >= 2 && _referenceGrid?.Renderer is { } renderer)
+                _ = CommitReferenceMovesAsync(renderer, _referenceMoveCommit.Select(
+                    item => new ReferenceGridRenderer.Move(item.Key, item.Value)).ToArray());
+        }
+        finally { _referenceMoveCommit = null; }
+        return true;
+    }
+
+    internal bool CollectReferenceCoordinatedPlacement(WidgetConfig config, RectInt32 bounds)
+    {
+        if (_referenceMoveCommit is null || !config.Metadata.TryGetValue(ReferenceGridPreview.BoxKey, out var id))
+            return false;
+        _referenceMoveCommit[id] = bounds;
+        return true;
+    }
+
+    private async Task CommitReferenceMovesAsync(ReferenceGridRenderer renderer, ReferenceGridRenderer.Move[] moves)
+    {
+        try
+        {
+            if (await renderer.SubmitMovesAsync(moves)) return;
+        }
+        catch (Exception error) { Log($"提交联动布局失败 {error.Message}"); }
+        foreach (var entry in _referenceWindows)
+        {
+            var saved = _referenceDefinitions.FirstOrDefault(item => item.Box ==
+                entry.Window.Config.Metadata[ReferenceGridPreview.BoxKey]);
+            if (saved is not null)
+                entry.Window.ApplyReferenceGridBounds(saved.Bounds, saved.Bounds, saved.Width, saved.Height);
+        }
+    }
+
+    private void ArrangeReferenceCapsules(ReferenceGridRenderer.Snapshot state)
+    {
+        if (!state.Visible || _referenceMove is not null) return;
+        var byId = _referenceWindows
+            .ToDictionary(entry => entry.Window.Config.Metadata[ReferenceGridPreview.BoxKey], entry => entry.Window);
+        foreach (string previous in _referenceCapsules.Keys.Where(id =>
+            !byId.TryGetValue(id, out var window) || !window.ReferenceCapsuleEligible).ToArray())
+        {
+            if (byId.TryGetValue(previous, out var window)) window.ClearCompactArrangementConstraint();
+            _referenceCapsules.Remove(previous);
+        }
+        if (state.CapsuleBar is null)
+        {
+            foreach (var previous in _referenceCapsules.Keys)
+                if (byId.TryGetValue(previous, out var window)) window.ResetReferenceCapsule();
+            _referenceCapsules.Clear();
+            return;
+        }
+
+        var entries = state.Boxes.Where(item => byId.TryGetValue(item.Box.Id, out var window) && window.ReferenceCapsuleEligible)
+            .Select(item =>
+            {
+                var bounds = new RectInt32(item.X, item.Y, item.Width, item.Height);
+                return (Id: item.Box.Id, Display: ReferenceDisplay(bounds), Bounds: byId[item.Box.Id].ReferenceCapsuleBounds(bounds));
+            });
+        foreach (var group in entries.GroupBy(entry => entry.Display.DisplayId))
+        {
+            var items = group.ToArray();
+            var work = items[0].Display.WorkArea;
+            bool vertical = state.CapsuleBar == "Vertical";
+            var order = items.OrderBy(item => vertical ? item.Bounds.Y : item.Bounds.X).ToArray();
+            var start = order[0].Bounds;
+            int spacing = (int)Math.Round(state.CapsuleSpacing * WidgetPositioningService.GetDpiScale(work));
+            var arrangement = WidgetCapsuleArrangementCalculator.Calculate(order.Select(item =>
+                new WidgetCapsuleArrangementItem(item.Id, item.Bounds.Width, item.Bounds.Height)).ToArray(),
+                work, new PointInt32(start.X, start.Y), WidgetPositionAnchors.LeftTop, state.CapsuleBar, spacing);
+            foreach (var item in arrangement)
+            {
+                var window = byId[item.Key];
+                if (!window.ReferenceCapsuleReady) continue;
+                if (!_referenceCapsules.TryGetValue(item.Key, out var previous) || previous != item.Value ||
+                    window.CoordinatedMoveBounds != item.Value)
+                    window.ApplyCompactArrangement(item.Value, constrainSize: true);
+                _referenceCapsules[item.Key] = item.Value;
+            }
+        }
+    }
+}
+#endif
