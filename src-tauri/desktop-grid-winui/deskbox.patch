+    private sealed record ReferenceWindow(string Box, string Group, string Title, RectInt32 Bounds, int Width, int Height,
+        bool Collapsed, WidgetCollapseBehavior Mode, ViewMode View, WidgetSortMode Sort,
+        ReferenceGridRenderer.BoxData? Saved, ReferenceGridRenderer.Tab? Tab, (string Id, string Name)[] Tabs)
+    {
+        internal bool Descending => Tab?.SortDescending ?? (Tab?.Sort is "date" or "size");
+    }
+
+    private static ReferenceWindow[] ReferenceDefinitions(ReferenceGridRenderer.Snapshot? snapshot)
+    {
+        if (snapshot is null)
+            return
+            [
+                new(ReferenceGridPreview.First, ReferenceGridPreview.First, "项目文件", new(40, 120, 300, 276), 300, 276,
+                    false, WidgetCollapseBehavior.Click, ViewMode.Icon, WidgetSortMode.Manual, null, null, []),
+                new(ReferenceGridPreview.Second, ReferenceGridPreview.Second, "资料归档", new(370, 120, 300, 276), 300, 276,
+                    true, WidgetCollapseBehavior.Smart, ViewMode.Icon, WidgetSortMode.Manual, null, null, []),
+            ];
+        if (!snapshot.Visible && snapshot.DesktopLayer is null)
+            return [];
+        return snapshot.Boxes.Select(placement =>
+        {
+            var box = placement.Box;
+            var tab = box.Tabs.First(item => item.Id == box.Active);
+            return new ReferenceWindow(box.Id, tab.Id, tab.Name,
+                new RectInt32(placement.X, placement.Y, placement.Width, placement.Height),
+                placement.LogicalWidth > 0 ? placement.LogicalWidth : placement.Width,
+                placement.LogicalHeight > 0 ? placement.LogicalHeight : placement.Height,
+                box.Collapsed, WidgetCollapseBehaviorNames.Normalize(box.CollapseMode,
+                    box.HoverExpand ? WidgetCollapseBehavior.Smart : WidgetCollapseBehavior.Click, allowSystem: true),
+                tab.List ? ViewMode.List : ViewMode.Icon,
