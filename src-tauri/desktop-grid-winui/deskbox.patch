+    private FileWidgetContentAdapter ReferenceContent(WidgetConfig config) =>
+        new(config, FileService, OrganizerService, SettingsService, LocalizationService, UiDispatcherQueue);
+
+    private static string ReadReferenceDefaultMode(ReferenceGridRenderer.Snapshot state) =>
+        WidgetCollapseBehaviorNames.ToSettingValue(
+            WidgetCollapseBehaviorNames.Normalize(state.DefaultCollapseMode, WidgetCollapseBehavior.Smart));
+
+    private async Task SetReferenceWindowsAsync(ReferenceWindow[] definitions, bool visibilityChanged = false,
+        bool defaultModeChanged = false)
+    {
+        _replacingReferenceWindows = true;
+        try
+        {
+            var previous = _referenceWindows.ToArray();
+            var byBox = previous.ToDictionary(entry => entry.Window.Config.Metadata[ReferenceGridPreview.BoxKey]);
+            var lastDefinitions = _referenceDefinitions.ToDictionary(item => item.Box);
+            var next = new List<(ContentWidgetWindow Window, FileWidgetContentAdapter Content)>();
+            var created = new List<(ContentWidgetWindow Window, FileWidgetContentAdapter Content)>();
+            var descriptor = new WidgetContentFactory(LocalizationService).GetDescriptor(WidgetKind.File);
+            foreach (var item in definitions)
+            {
+                if (byBox.TryGetValue(item.Box, out var reusable) && lastDefinitions.TryGetValue(item.Box, out var old))
+                {
+                    var (existing, currentContent) = reusable;
+                    if (item.Group != old.Group || item.Tab?.Folder != old.Tab?.Folder)
+                    {
+                        var nextConfig = ReferenceConfig(item);
+                        nextConfig.CompactPlacement = existing.Config.CompactPlacement;
+                        nextConfig.CompactWidth = existing.Config.CompactWidth;
+                        nextConfig.PositionAnchor = existing.Config.PositionAnchor;
+                        nextConfig.IsCollapsed = existing.Config.IsCollapsed;
+                        WidgetCollapseBehaviorNames.SetOverride(nextConfig, WidgetCollapseBehaviorNames.GetOverride(existing.Config));
+                        var replacement = ReferenceContent(nextConfig);
+                        await existing.SwitchReferenceGroupAsync(nextConfig, replacement, descriptor);
+                        replacement.ViewModel.EnableReferenceGridHydration();
+                        currentContent = replacement;
+                    }
+                    else
+                    {
+                        if (item.Title != old.Title)
+                            existing.ApplyReferenceTitle(item.Title);
+                        if (!item.Tabs.SequenceEqual(old.Tabs) ||
+                            item.Saved?.GroupNavigation != old.Saved?.GroupNavigation ||
+                            item.Saved?.GroupTitleDisplay != old.Saved?.GroupTitleDisplay ||
+                            item.Saved?.GroupWheel != old.Saved?.GroupWheel ||
+                            item.Saved?.GroupHover != old.Saved?.GroupHover)
+                            existing.RefreshReferenceGroupTabs();
+                        currentContent.ViewModel.ApplyReferencePresentation(item.View, item.Sort, item.Descending,
+                            item.Tab?.StackByType ?? false);
+                        currentContent.ViewModel.ApplyReferenceStackSettings(item.Tab?.StackSettings);
+                        if (item.Tab is { } tab && old.Tab is { } previousTab &&
+                            !tab.Items.SequenceEqual(previousTab.Items, StringComparer.OrdinalIgnoreCase))
+                            await currentContent.ViewModel.RefreshReferenceGridAsync();
+                        if (item.Tab?.FolderOpen != old.Tab?.FolderOpen)
+                        {
+                            FileWidgetFolderOpenBehaviorNames.SetOverride(existing.Config, item.Tab?.FolderOpen);
+                            await currentContent.ApplyFolderOpenBehaviorChangeAsync();
+                        }
+                    }
+                    existing.ApplyReferenceGridBounds(old.Bounds, item.Bounds, item.Width, item.Height);
+                    existing.ApplyReferenceLocks(item.Saved?.LocksPosition ?? false, item.Saved?.LocksSize ?? false);
+                    if (item.Saved?.ExpansionDirection != old.Saved?.ExpansionDirection)
+                        existing.ApplyReferenceExpansionDirection(item.Saved?.ExpansionDirection);
+                    if (item.Saved?.CapsuleWidth != old.Saved?.CapsuleWidth)
+                        existing.ApplyReferenceCompactWidth(item.Saved?.CapsuleWidth);
+                    bool changedColor = item.Saved?.Color != old.Saved?.Color || item.Saved?.Opacity != old.Saved?.Opacity;
+                    if (changedColor)
+                        ReferenceGridPreview.SetAppearance(existing.Config, item.Saved?.Color, item.Saved?.Opacity ?? 90);
+                    bool changedArtwork = ReferenceGridPreview.ApplyMetadata(existing.Config, ReferenceGridPreview.ArtworkKeys,
+                        item.Tab?.Artwork, WidgetBackgroundCustomization.ColorMetadataKey);
+                    if (!changedColor && !Equals(item.Tab?.Artwork?.GetValueOrDefault(WidgetBackgroundCustomization.ColorMetadataKey),
+                            old.Tab?.Artwork?.GetValueOrDefault(WidgetBackgroundCustomization.ColorMetadataKey)) &&
+                        item.Tab?.Artwork?.ContainsKey(WidgetBackgroundCustomization.ColorMetadataKey) != true)
+                    {
+                        ReferenceGridPreview.SetAppearance(existing.Config, item.Saved?.Color, item.Saved?.Opacity ?? 90);
+                        changedArtwork = true;
+                    }
+                    if (changedColor || changedArtwork)
+                    {
+                        existing.ApplyAppearancePreview();
+                        existing.ApplyReferenceArtwork();
+                    }
+                    bool followsChangedDefault = item.Mode == WidgetCollapseBehavior.System && defaultModeChanged;
+                    if (item.Mode != old.Mode || item.Collapsed != old.Collapsed || followsChangedDefault)
+                        existing.ApplyReferenceCollapse(item.Mode, item.Collapsed, followsChangedDefault);
+                    next.Add((existing, currentContent));
+                    continue;
+                }
+
+                var config = ReferenceConfig(item);
+                var content = ReferenceContent(config);
+                var window = new ContentWidgetWindow(config, content, SettingsService, descriptor)
+                {
+                    Title = item.Title + " · 桌面格子",
+                };
+                _referenceWindows.Add((window, content));
+                created.Add((window, content));
+                next.Add((window, content));
+                window.Closed += (_, _) =>
+                {
+                    _referenceWindows.RemoveAll(entry => ReferenceEquals(entry.Window, window));
+                    if (_referenceWindows.Count == 0 && !_replacingReferenceWindows)
+                        Exit();
+                };
+                window.PrepareReferenceGrid();
+                RecordReferenceStartup($"{item.Group}-created");
+            }
+            if (created.Count > 0)
+            {
+                using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(45));
+                await Task.WhenAll(created.Select(entry => entry.Window.ContentReadyTask)).WaitAsync(timeout.Token);
+                RecordReferenceStartup("content-ready");
+                while (created.Any(entry => entry.Window.Content is not FrameworkElement
+                       { IsLoaded: true, XamlRoot: not null, ActualWidth: > 0, ActualHeight: > 0 }))
+                    await Task.Delay(30, timeout.Token);
+                var frame = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
+                void OnRendering(object? sender, object args) => frame.TrySetResult();
+                CompositionTarget.Rendering += OnRendering;
+                try { await frame.Task.WaitAsync(timeout.Token); }
+                finally { CompositionTarget.Rendering -= OnRendering; }
+                foreach (var entry in created)
+                {
+                    if (_referenceGrid?.Renderer?.State.DesktopLayer is not null &&
+                        !WidgetLayerService.AttachReferenceGridToDesktop(entry.Window.WindowHandle))
+                        throw new InvalidOperationException("无法将格子窗口挂到当前桌面。");
+                    entry.Content.ViewModel.EnableReferenceGridHydration();
+                }
+            }
+
+            foreach (var entry in visibilityChanged ? next : created)
+                entry.Window.SetReferenceGridVisible(_referenceGrid?.Renderer?.State.Visible ?? true);
+            foreach (var entry in previous)
+            {
+                if (!next.Contains(entry))
+                    entry.Window.Close();
+            }
+            _referenceWindows.Clear();
+            _referenceWindows.AddRange(next);
+            _referenceDefinitions = definitions;
+        }
+        finally
+        {
+            _replacingReferenceWindows = false;
+        }
+    }
+
+    private async Task RefreshReferenceMembersAsync()
+    {
+        foreach (var entry in _referenceWindows.ToArray())
+            await entry.Content.ViewModel.RefreshReferenceGridAsync();
+    }
+
+    private void ObserveReferenceRenderer(ReferenceGridRenderer renderer)
+    {
+        var heartbeat = UiDispatcherQueue.CreateTimer();
+        if (renderer.State.DesktopLayer is not null)
+        {
+            void Pulse()
+            {
+                if (!_replacingReferenceWindows)
+                    renderer.WritePulse(_referenceWindows.Select(entry => entry.Window.WindowHandle));
+            }
+            Pulse();
+            heartbeat.Interval = TimeSpan.FromMilliseconds(750);
+            heartbeat.Tick += (_, _) =>
+            {
+                try { Pulse(); }
+                catch (IOException error) { Log($"无法写入格子界面心跳 {error.Message}"); }
+                catch (UnauthorizedAccessException error) { Log($"无法写入格子界面心跳 {error.Message}"); }
+            };
+            heartbeat.Start();
+        }
+        var timer = UiDispatcherQueue.CreateTimer();
+        timer.Interval = TimeSpan.FromMilliseconds(250);
+        timer.Tick += async (_, _) =>
+        {
+            if (_pollingReferenceRenderer)
+                return;
+            _pollingReferenceRenderer = true;
+            try
+            {
+                if (!renderer.OwnerAlive)
+                {
+                    heartbeat.Stop();
+                    timer.Stop();
+                    Exit();
+                    return;
+                }
+                if (renderer.HasPendingRequest || _referenceWindows.Any(entry => entry.Window.ReferencePlacementInProgress))
+                    return;
+                bool wasVisible = renderer.State.Visible;
+                if (renderer.Refresh())
+                {
+                    if (renderer.State.Closing)
+                    {
+                        heartbeat.Stop();
+                        timer.Stop();
+                        Exit();
+                        return;
+                    }
+                    string defaultMode = ReadReferenceDefaultMode(renderer.State);
+                    UpdateReferenceStackRules(renderer.State);
+                    bool changedDefaultMode = SettingsService.Settings.WidgetCollapseBehavior != defaultMode;
+                    SettingsService.Settings.WidgetCollapseBehavior = defaultMode;
+                    await SetReferenceWindowsAsync(ReferenceDefinitions(renderer.State),
+                        wasVisible != renderer.State.Visible, changedDefaultMode);
+                }
+                ArrangeReferenceCapsules(renderer.State);
+            }
+            catch (Exception error)
+            {
+                heartbeat.Stop();
+                timer.Stop();
+                Log($"读取 SoulDesk 格子状态失败 {error}");
+                Exit();
+            }
+            finally
+            {
+                _pollingReferenceRenderer = false;
+            }
+        };
+        timer.Start();
+    }
+}
+#endif
