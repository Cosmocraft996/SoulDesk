+++ b/src/DeskBox/Services/ReferenceGridRenderer.cs
@@ -0,0 +1,221 @@
+#if SOULDESK_GRID_PREVIEW
+using System.Diagnostics;
+using System.Globalization;
+using System.Text.Json;
+using DeskBox.Platform;
+using System.Text;
+using Windows.Graphics;
+
+namespace DeskBox.Services;
+
+internal sealed class ReferenceGridRenderer
+{
+    internal sealed record Tab(string Id, string Name, string? Folder, string Sort, bool List,
+        bool StackByType, string[] Items, bool? SortDescending, string? FolderOpen,
+        Dictionary<string, string>? StackSettings, Dictionary<string, string>? Artwork, bool? AutoStack, double? IconSize);
+    internal sealed record BoxData(string Id, bool Collapsed, bool Locked, bool HoverExpand,
+        string Active, Tab[] Tabs, string? CollapseMode, bool? PositionLocked, bool? SizeLocked,
+        string? ExpansionDirection, string? Color, int Opacity, double? CapsuleWidth,
+        string? GroupNavigation, string? GroupTitleDisplay, bool? GroupWheel, bool GroupHover, string? BoundMonitor, bool? GroupHoverOverride, bool UseCustomOpacity)
+    {
+        internal bool LocksPosition => PositionLocked ?? Locked;
+        internal bool LocksSize => SizeLocked ?? Locked;
+    }
+    internal sealed record Placement(BoxData Box, int X, int Y, int Width, int Height,
+        int LogicalWidth, int LogicalHeight);
+    internal sealed record DesktopIdentity(long Handle, int Pid, int Session);
+    internal sealed record DisplayInfo(string Id, string Name, bool Primary);
+    internal sealed record Move(string Box, RectInt32 Bounds);
+    internal sealed record StackRule(string Id, string Name, string[] Extensions);
+    internal sealed record Preference(string Row, string Key, string Kind, string[]? Values, string[]? Labels,
+        double Min, double Max, double Step);
+    internal sealed record Snapshot(int Version, int MaximumTabs, int OwnerPid, string OwnerStarted, string Session,
+        long Revision, bool Visible, bool Closing, DesktopIdentity? DesktopLayer, string? DesktopStarted,
+        Placement[] Boxes, string[] Files,
+        string? Completed, string[] Accepted, string? Error, string? DefaultCollapseMode,
+        DisplayInfo[]? Displays, string? CapsuleBar, int CapsuleSpacing, bool CoordinatedMove, StackRule[]? StackRules,
+        bool SettingsOnly, bool Isolated, bool AutoSort, bool IncludePublic, bool SearchIndexed, string? EverythingCli,
+        long SettingsFocus, string? SettingsPage, Dictionary<string, string>? Preferences, Preference[]? PreferenceRows, string? NewWidgetMonitor);
+
+    private readonly string _directory;
+    private readonly SemaphoreSlim _submissions = new(1);
+    private readonly Process _owner;
+    private Snapshot _state;
+    private HashSet<string> _allowed;
+    private long _pulse;
+
+    internal ReferenceGridRenderer(string directory, bool desktop, bool settingsOnly = false)
+    {
+        _directory = directory;
+        _state = Read();
+        if (_state.Version != 1 || Path.GetFileName(directory) != "deskbox-renderer-" + _state.Session ||
+            !Guid.TryParseExact(_state.Session, "N", out _) || desktop != (_state.DesktopLayer is not null) ||
+            _state.SettingsOnly != settingsOnly)
+            throw new InvalidDataException("无法确认 SoulDesk 格子会话。");
+        _owner = Process.GetProcessById(_state.OwnerPid);
+        if (_owner.HasExited || _owner.SessionId != Process.GetCurrentProcess().SessionId ||
+            _owner.StartTime.ToUniversalTime().Ticks.ToString(CultureInfo.InvariantCulture) != _state.OwnerStarted)
+        {
+            _owner.Dispose();
+            throw new InvalidDataException("SoulDesk 格子引擎已经退出。");
+        }
+        _allowed = new HashSet<string>(_state.Files, StringComparer.OrdinalIgnoreCase);
+        if (desktop && DesktopOwner == IntPtr.Zero)
+            throw new InvalidDataException("Windows 桌面图标层身份不一致。");
+    }
+
+    internal Snapshot State => _state;
+    internal bool HasPendingRequest => _submissions.CurrentCount == 0;
+    internal bool OwnerAlive => !_owner.HasExited;
+    internal bool Contains(string path) => _allowed.Contains(path);
+    internal IntPtr DesktopOwner
+    {
+        get
+        {
+            if (_state.DesktopLayer is not { } layer || layer.Handle == 0)
+                return IntPtr.Zero;
+            var hwnd = new IntPtr(layer.Handle);
+            Win32Helper.GetWindowThreadProcessId(hwnd, out uint pid);
+            if (pid != layer.Pid || layer.Session != _owner.SessionId)
+                return IntPtr.Zero;
+            var name = new StringBuilder(64);
+            if (Win32Helper.GetAncestor(hwnd, 2) != hwnd ||
+                Win32Helper.GetClassName(hwnd, name, name.Capacity) == 0 ||
+                name.ToString() is not ("Progman" or "WorkerW"))
+                return IntPtr.Zero;
+            var iconView = Win32Helper.FindWindowEx(hwnd, IntPtr.Zero, "SHELLDLL_DefView", null);
+            if (iconView == IntPtr.Zero || Win32Helper.GetWindowThreadProcessId(iconView, out uint viewPid) == 0 ||
+                viewPid != pid)
+                return IntPtr.Zero;
+            try
+            {
+                using var explorer = Process.GetProcessById(layer.Pid);
+                if (!explorer.HasExited && explorer.SessionId == layer.Session &&
+                    explorer.StartTime.ToUniversalTime().Ticks.ToString(CultureInfo.InvariantCulture) == _state.DesktopStarted)
+                    return hwnd;
+            }
+            catch (ArgumentException) { }
+            catch (InvalidOperationException) { }
+            catch (System.ComponentModel.Win32Exception) { }
+            return IntPtr.Zero;
+        }
+    }
+
+    internal bool Refresh()
+    {
+        Snapshot next = Read();
+        if (next.Session != _state.Session || next.OwnerStarted != _state.OwnerStarted ||
+            next.OwnerPid != _state.OwnerPid || next.Version != _state.Version || next.Revision < _state.Revision ||
+            next.DesktopLayer != _state.DesktopLayer || next.DesktopStarted != _state.DesktopStarted ||
+            next.SettingsOnly != _state.SettingsOnly)
+            throw new InvalidDataException("SoulDesk 格子会话已改变。");
+        bool changed = next.Revision != _state.Revision;
+        if (changed)
+            _allowed = new HashSet<string>(next.Files, StringComparer.OrdinalIgnoreCase);
+        _state = next;
+        return changed;
+    }
+
+    internal void WritePulse(IEnumerable<IntPtr> windows)
+    {
+        string staged = Path.Combine(_directory, "pulse.tmp");
+        File.WriteAllText(staged, JsonSerializer.Serialize(new
+        {
+            _state.Session, Pid = Environment.ProcessId, Counter = ++_pulse, _state.Revision,
+            Windows = windows.Select(window => window.ToInt64()).ToArray()
+        }));
+        File.Move(staged, Path.Combine(_directory, "pulse.json"), overwrite: true);
+    }
+
+    private Snapshot Read()
+    {
+        using var input = new FileStream(Path.Combine(_directory, "state.json"),
+            FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
+        if (input.Length > 4 * 1024 * 1024)
+            throw new InvalidDataException("SoulDesk 格子布局超过 4 MiB。");
+        return JsonSerializer.Deserialize<Snapshot>(input)
+            ?? throw new InvalidDataException("SoulDesk 格子布局为空。");
+    }
+
+    internal async Task<IReadOnlyList<string>> SubmitAsync(string action, string tab, string[] paths,
+        string? before, CancellationToken cancellationToken, string[]? displayOrder = null) =>
+        (await SendAsync(action, tab, paths, before, null, null, null, null, null, null,
+            cancellationToken, displayOrder: displayOrder))?.Accepted ?? [];
+
+    internal async Task<bool> SubmitBoxAsync(string action, string box, string? tab = null, bool? collapsed = null,
+        RectInt32? bounds = null, string? target = null, string[]? expectedTabs = null, string? collapseMode = null,
+        double? capsuleWidth = null) =>
+        await SendAsync(action, tab, [], null, box, collapsed, bounds, target, expectedTabs, collapseMode,
+            CancellationToken.None, capsuleWidth: capsuleWidth) is not null;
+
+    internal async Task<bool> SubmitSettingAsync(string action, string box, string tab, string setting, string? value,
+        Dictionary<string, string>? metadata = null) =>
+        await SendAsync(action, tab, [], null, box, null, null, null, null, null,
+            CancellationToken.None, setting, value, metadata: metadata) is not null;
+
+    internal async Task<bool> SubmitMovesAsync(Move[] moves) =>
+        await SendAsync("move-many", null, [], null, null, null, null, null, null, null,
+            CancellationToken.None, moves: moves) is not null;
+
+    private async Task<Snapshot?> SendAsync(string action, string? tab, string[] paths, string? before,
+        string? box, bool? collapsed, RectInt32? bounds, string? target, string[]? expectedTabs, string? collapseMode,
+        CancellationToken cancellationToken, string? setting = null, string? value = null, double? capsuleWidth = null,
+        string[]? displayOrder = null, Dictionary<string, string>? metadata = null, Move[]? moves = null)
+    {
+        await _submissions.WaitAsync(cancellationToken);
+        try
+        {
+            if (!OwnerAlive)
+                return null;
+            Snapshot published = Read();
+            if (published.Session != _state.Session || published.Revision < _state.Revision)
+                return null;
+            string id = Guid.NewGuid().ToString("N");
+            string staged = Path.Combine(_directory, "request-" + id + ".tmp");
+            File.WriteAllText(staged, JsonSerializer.Serialize(new
+            {
+                published.Version, published.Session, published.Revision,
+                Id = id, Action = action, Box = box, Tab = tab, Paths = paths, Before = before, Collapsed = collapsed,
+                Target = target, ExpectedTabs = expectedTabs, CollapseMode = collapseMode, Setting = setting, Value = value,
+                CapsuleWidth = capsuleWidth, DisplayOrder = displayOrder, Metadata = metadata,
+                Moves = moves?.Select(move => new
+                {
+                    move.Box,
+                    Bounds = new { move.Bounds.X, move.Bounds.Y, move.Bounds.Width, move.Bounds.Height }
+                }),
+                Bounds = bounds is { } rect ? new { rect.X, rect.Y, rect.Width, rect.Height } : null
+            }));
+            try
+            {
+                File.Move(staged, Path.Combine(_directory, "request.json"), overwrite: true);
+            }
+            finally
+            {
+                if (File.Exists(staged))
+                    File.Delete(staged);
+            }
+
+            using var timeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+            timeout.CancelAfter(TimeSpan.FromSeconds(5));
+            while (OwnerAlive)
+            {
+                Snapshot reply = Read();
+                if (reply.Session != _state.Session)
+                    break;
+                if (reply.Completed == id)
+                {
+                    if (reply.Error is { } error)
+                        throw new InvalidOperationException(error);
+                    return reply;
+                }
+                await Task.Delay(65, timeout.Token);
+            }
+            return null;
+        }
+        finally
+        {
+            _submissions.Release();
+        }
+    }
+}
+#endif
