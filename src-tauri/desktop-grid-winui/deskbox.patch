+
+    internal async Task<bool> SubmitBoxAsync(string action, string box, string? tab = null, bool? collapsed = null,
+        RectInt32? bounds = null, string? target = null, string[]? expectedTabs = null, string? collapseMode = null,
+        double? capsuleWidth = null) =>
