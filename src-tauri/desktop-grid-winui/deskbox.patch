+#if SOULDESK_GRID_PREVIEW
+using DeskBox.Controls;
+using DeskBox.Controls.WidgetContents;
+using DeskBox.Models;
+using DeskBox.Services;
+using Microsoft.UI.Xaml.Controls;
+using System.Diagnostics;
+
+namespace DeskBox.Views;
+
+public sealed partial class ContentWidgetWindow
+{
+    private bool SubmitReferenceGridSetting(string setting, string? value = null, string action = "edit")
+    {
+        if (ReferenceGridPreview.Current?.SubmitSettingAsync(_config, setting, value, action) is not { } request)
+            return false;
+        _ = ReferenceGridPreview.ObserveBoxEditAsync(request);
+        return true;
+    }
+
+    internal void ApplyReferenceTitle(string name)
+    {
+        _config.Name = name;
+        if (CurrentContent is FileWidgetContentAdapter file)
+            file.ViewModel.Name = name;
+        _titleViewModel.RefreshDisplayName();
+        Title = name + " · 桌面格子";
+    }
+
+    internal void ApplyReferenceArtwork()
+    {
+        InvalidateCustomAssetSources();
+        ApplyCustomWidgetBackground();
+        ApplyCustomTitleIconAndGroupIdentity();
+    }
+
+    internal void ApplyReferenceLocks(bool position, bool size)
+    {
+        if (_config.IsPositionLocked == position && _config.IsSizeLocked == size)
+            return;
+        _config.IsPositionLocked = position;
+        _config.IsSizeLocked = size;
+        ApplyLockActionIconState();
+    }
+
+    private MenuFlyout CreateReferenceGridCreationMenu()
+    {
+        var flyout = new MenuFlyout();
+        AppendReferenceGridCreation(flyout);
+        return flyout;
+    }
+
+    private void AppendReferenceGridCreation(MenuFlyout flyout)
+    {
+        var localization = App.Current.LocalizationService;
+        flyout.Items.Add(ReferenceGridMenuItem(localization.T("Common.NewWidget"), "\uE710", () => SubmitReferenceGridSetting("new", action: "show")));
+        flyout.Items.Add(ReferenceGridMenuItem(localization.T("Common.NewFolderMapping"), "\uE8B7", () => SubmitReferenceGridSetting("map", action: "show")));
+        flyout.Items.Add(ReferenceGridMenuItem(localization.T("Common.AddFeatureWidget"), "\uE710", () => SubmitReferenceGridSetting("feature-settings", action: "show")));
+    }
+
+    private MenuFlyout CreateReferenceGridMenu()
+    {
+        var renderer = ReferenceGridPreview.Current!.Renderer!;
+        var localization = App.Current.LocalizationService;
+        var flyout = new MenuFlyout();
+        var rename = new MenuFlyoutItem { Text = localization.T("Common.Rename"), Icon = new FontIcon { Glyph = "\uE8AC" } };
+        bool renameRequested = false;
+        rename.Click += (_, _) => renameRequested = true;
+        flyout.Closed += (_, _) =>
+        {
+            if (renameRequested) DispatcherQueue.TryEnqueue(StartTitleRename);
+        };
+        flyout.Items.Add(rename);
+        var tab = renderer.State.Boxes.SelectMany(box => box.Box.Tabs).FirstOrDefault(tab => tab.Id == _config.Id);
+        var style = new MenuFlyoutSubItem { Text = localization.T("Widget.StyleMenu.Label"), Icon = new FontIcon { Glyph = "\uE790" } };
+        Action? showCustomizer = null;
+        style.Items.Add(ReferenceGridMenuItem(localization.T("Widget.CustomIcon.MenuLabel"), "\uE890", () => showCustomizer = ShowTitleIconCustomizer));
+        style.Items.Add(ReferenceGridMenuItem(localization.T("Widget.CustomBackground.MenuLabel"), "\uE91B", () => showCustomizer = ShowWidgetBackgroundCustomizer));
